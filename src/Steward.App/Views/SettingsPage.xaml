<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Steward.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Steward.App.ViewModels"
    SizeChanged="OnSizeChanged">

    <Page.Resources>
        <DataTemplate x:Key="ChannelCardTemplate" x:DataType="vm:AddonChannelViewModel">
            <controls:SettingsCard Header="{x:Bind Name}" Description="{x:Bind Description, Mode=OneWay}" Padding="{StaticResource SettingsExpanderItemPadding}">
                <controls:SettingsCard.HeaderIcon>
                    <ImageIcon Source="{x:Bind Icon}" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        Text="No releases yet"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="{x:Bind NoReleasesVisibility, Mode=OneWay}" />
                    <controls:Segmented
                        SelectionMode="Single"
                        SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}"
                        Visibility="{x:Bind PickerVisibility, Mode=OneWay}">
                        <controls:SegmentedItem
                            Content="{x:Bind Option1Label}"
                            IsEnabled="{x:Bind Option1Enabled, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Option1Tooltip, Mode=OneWay}" />
                        <controls:SegmentedItem
                            Content="{x:Bind Option2Label}"
                            IsEnabled="{x:Bind Option2Enabled, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Option2Tooltip, Mode=OneWay}"
                            Visibility="{x:Bind Option2Visibility, Mode=OneWay}" />
                        <controls:SegmentedItem
                            Content="{x:Bind Option3Label}"
                            IsEnabled="{x:Bind Option3Enabled, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Option3Tooltip, Mode=OneWay}"
                            Visibility="{x:Bind Option3Visibility, Mode=OneWay}" />
                    </controls:Segmented>
                </StackPanel>
            </controls:SettingsCard>
        </DataTemplate>

        <DataTemplate x:Key="InstallCardTemplate" x:DataType="vm:WowInstallViewModel">
            <controls:SettingsCard Header="{x:Bind DisplayName}" Description="{x:Bind FlavourPath}" Padding="{StaticResource SettingsExpanderItemPadding}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        Padding="6,2"
                        Background="{ThemeResource ChipBrush}">
                        <TextBlock
                            Text="{x:Bind ClientVersion}"
                            FontFamily="Cascadia Mono"
                            FontSize="11.5"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Border
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        Padding="8,2"
                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                        Visibility="{x:Bind AddedByYouVisibility, Mode=OneWay}">
                        <TextBlock Text="Added by you" FontSize="12" />
                    </Border>
                    <Button Content="Remove" Command="{x:Bind RemoveCommand}" />
                </StackPanel>
            </controls:SettingsCard>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            x:Name="Column"
            MaxWidth="1064"
            HorizontalAlignment="Center"
            Padding="{StaticResource PageGutter}"
            Spacing="4">

            <TextBlock Text="Account" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />

            <StackPanel Spacing="1">
                <controls:SettingsCard
                    CornerRadius="{StaticResource GroupTopCornerRadius}"
                    Header="{x:Bind ViewModel.UserName, Mode=OneWay}"
                    Description="Signed in with Discord, guild.hoobi.io">
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon Width="32" Height="32" Source="{x:Bind ViewModel.AvatarImage, Mode=OneWay}" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border
                            VerticalAlignment="Center"
                            CornerRadius="4"
                            Padding="6,2"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="{x:Bind ViewModel.RoleLabel, Mode=OneWay}" Foreground="{ThemeResource AccentButtonForeground}" FontSize="12" />
                        </Border>
                        <Button
                            Content="Sign out"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Command="{x:Bind ViewModel.SignOutCommand}" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    CornerRadius="{StaticResource GroupBottomCornerRadius}"
                    Header="Guild panel"
                    Description="guild.hoobi.io"
                    IsClickEnabled="True"
                    Click="OnGuildPanelClick">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                    </controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>
            </StackPanel>

            <controls:SettingsExpander
                Margin="0,20,0,0"
                Header="Release channels"
                Description="Channel is set per addon"
                IsExpanded="True"
                ItemsSource="{x:Bind ViewModel.AddonChannels}"
                ItemTemplate="{StaticResource ChannelCardTemplate}">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </controls:SettingsExpander.HeaderIcon>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                Margin="0,20,0,0"
                Header="Installs"
                Description="{x:Bind ViewModel.InstallsDescription, Mode=OneWay}"
                IsExpanded="True"
                ItemsSource="{x:Bind ViewModel.Installs}"
                ItemTemplate="{StaticResource InstallCardTemplate}">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </controls:SettingsExpander.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Rescan" Command="{x:Bind ViewModel.RescanCommand}" />
                    <Button Content="Add install" Command="{x:Bind ViewModel.BrowseCommand}" />
                </StackPanel>
            </controls:SettingsExpander>

            <TextBlock Text="Behaviour" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" />

            <StackPanel Spacing="1">
                <controls:SettingsCard
                    CornerRadius="{StaticResource GroupTopCornerRadius}"
                    Header="Minimise to the tray"
                    Description="Minimising the window hides Steward to the tray instead of the taskbar">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7C4;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    CornerRadius="{StaticResource GroupMiddleCornerRadius}"
                    Header="Close to the tray"
                    Description="Closing the window keeps Steward running in the tray instead of quitting">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8BB;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    CornerRadius="{StaticResource GroupMiddleCornerRadius}"
                    Header="Auto-update addons"
                    Description="{x:Bind ViewModel.AutoUpdateDescription, Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE777;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:Segmented
                        SelectionMode="Single"
                        SelectedIndex="{x:Bind ViewModel.AutoUpdateIndex, Mode=TwoWay}">
                        <controls:SegmentedItem Content="Always" />
                        <controls:SegmentedItem Content="Out-of-game" />
                        <controls:SegmentedItem Content="Never" />
                    </controls:Segmented>
                </controls:SettingsCard>

                <controls:SettingsCard
                    CornerRadius="{StaticResource GroupBottomCornerRadius}"
                    Header="Start with Windows"
                    Description="{x:Bind ViewModel.StartWithWindowsDescription, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanStartWithWindows, Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                </controls:SettingsCard>
            </StackPanel>

            <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" />

            <StackPanel Spacing="1">
                <controls:SettingsCard
                    x:Name="ChannelCard"
                    CornerRadius="{StaticResource GroupTopCornerRadius}"
                    Header="Update channel"
                    Description="Pre-release builds come from every push to main, release builds from a merged release PR">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE895;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:Segmented
                        SelectionMode="Single"
                        SelectedIndex="{x:Bind ViewModel.AppChannelIndex, Mode=TwoWay}">
                        <controls:SegmentedItem Content="release" />
                        <controls:SegmentedItem Content="pre-release" />
                    </controls:Segmented>
                </controls:SettingsCard>

                <controls:SettingsCard
                    x:Name="AboutCard"
                    CornerRadius="{StaticResource GroupMiddleCornerRadius}"
                    Header="Steward"
                    Description="{x:Bind ViewModel.AboutDescription, Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Bind ViewModel.AboutActionLabel, Mode=OneWay}" Command="{x:Bind ViewModel.CheckOrInstallAppUpdateCommand}" />
                        <Button Content="Release notes" Click="OnReleasesClick" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    CornerRadius="{StaticResource GroupMiddleCornerRadius}"
                    Header="App data"
                    Description="{x:Bind ViewModel.StatePath, Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button Content="Open folder" Click="OnOpenDataFolderClick" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    CornerRadius="{StaticResource GroupBottomCornerRadius}"
                    Header="Source and issues"
                    Description="github.com/hoobio/steward-companion"
                    IsClickEnabled="True"
                    Click="OnRepositoryClick">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE943;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                    </controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
