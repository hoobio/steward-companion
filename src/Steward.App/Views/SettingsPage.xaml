<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Steward.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Steward.App.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="ChannelCardTemplate" x:DataType="vm:AddonChannelViewModel">
            <controls:SettingsCard Header="{x:Bind Name}" Description="{x:Bind Description, Mode=OneWay}">
                <controls:SettingsCard.HeaderIcon>
                    <ImageIcon Source="{x:Bind Icon}" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        Text="No releases yet"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="{x:Bind NoReleasesVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind SelectedChannelText, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ReadOnlyVisibility, Mode=OneWay}" />
                    <controls:Segmented
                        SelectionMode="Single"
                        SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}"
                        Visibility="{x:Bind PickerVisibility, Mode=OneWay}">
                        <controls:SegmentedItem
                            Content="stable"
                            IsEnabled="{x:Bind StableEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind StableTooltip, Mode=OneWay}" />
                        <controls:SegmentedItem
                            Content="beta"
                            IsEnabled="{x:Bind BetaEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind BetaTooltip, Mode=OneWay}" />
                        <controls:SegmentedItem
                            Content="unstable"
                            IsEnabled="{x:Bind UnstableEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind UnstableTooltip, Mode=OneWay}"
                            Visibility="{x:Bind UnstableVisibility, Mode=OneWay}" />
                    </controls:Segmented>
                </StackPanel>
            </controls:SettingsCard>
        </DataTemplate>

        <DataTemplate x:Key="InstallCardTemplate" x:DataType="vm:WowInstallViewModel">
            <controls:SettingsCard Header="{x:Bind DisplayName}" Description="{x:Bind FlavourPath}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        Padding="6,2"
                        Background="{ThemeResource ChipBrush}">
                        <TextBlock
                            Text="{x:Bind ClientVersion}"
                            FontFamily="Cascadia Mono"
                            FontSize="11.5"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Border
                        VerticalAlignment="Center"
                        CornerRadius="10"
                        Padding="8,2"
                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                        Visibility="{x:Bind AddedByYouVisibility, Mode=OneWay}">
                        <TextBlock Text="Added by you" FontSize="12" />
                    </Border>
                    <Button Content="Remove" Command="{x:Bind RemoveCommand}" />
                </StackPanel>
            </controls:SettingsCard>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1064"
            HorizontalAlignment="Stretch"
            Padding="{StaticResource PageGutter}"
            Spacing="4">

            <TextBlock Text="Account" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />

            <controls:SettingsCard
                Header="{x:Bind ViewModel.UserName, Mode=OneWay}"
                Description="Signed in with Discord, guild.hoobi.io">
                <controls:SettingsCard.HeaderIcon>
                    <ImageIcon Width="32" Height="32" Source="{x:Bind ViewModel.AvatarImage, Mode=OneWay}" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        Padding="6,2"
                        Background="{ThemeResource AccentFillColorTertiaryBrush}">
                        <TextBlock Text="{x:Bind ViewModel.RoleLabel, Mode=OneWay}" FontSize="12" />
                    </Border>
                    <Button
                        Content="Sign out"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Command="{x:Bind ViewModel.SignOutCommand}" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard
                Header="Guild panel"
                Description="guild.hoobi.io"
                IsClickEnabled="True"
                Click="OnGuildPanelClick">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </controls:SettingsCard.HeaderIcon>
                <controls:SettingsCard.ActionIcon>
                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                </controls:SettingsCard.ActionIcon>
            </controls:SettingsCard>

            <controls:SettingsExpander
                Margin="0,20,0,0"
                Header="Release channels"
                Description="Each addon follows its own channel"
                IsExpanded="True"
                ItemsSource="{x:Bind ViewModel.AddonChannels}"
                ItemTemplate="{StaticResource ChannelCardTemplate}">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </controls:SettingsExpander.HeaderIcon>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                Margin="0,20,0,0"
                Header="Installs"
                Description="{x:Bind ViewModel.InstallsDescription, Mode=OneWay}"
                IsExpanded="True"
                ItemsSource="{x:Bind ViewModel.Installs}"
                ItemTemplate="{StaticResource InstallCardTemplate}">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </controls:SettingsExpander.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Rescan" Command="{x:Bind ViewModel.RescanCommand}" />
                    <Button Content="Add install" Command="{x:Bind ViewModel.BrowseCommand}" />
                </StackPanel>
            </controls:SettingsExpander>

            <TextBlock Text="Behaviour" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" />

            <controls:SettingsCard
                Header="Keep running in the tray"
                Description="Closing or minimising the window hides Steward to the tray instead of quitting">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7C4;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.KeepInTray, Mode=TwoWay}" />
            </controls:SettingsCard>

            <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" />

            <controls:SettingsCard Header="Steward" Description="{x:Bind ViewModel.AboutDescription, Mode=OneWay}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </controls:SettingsCard.HeaderIcon>
                <Button Content="Check for a new version" Click="OnReleasesClick" />
            </controls:SettingsCard>

            <controls:SettingsCard Header="App data" Description="{x:Bind ViewModel.StatePath, Mode=OneWay}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </controls:SettingsCard.HeaderIcon>
                <Button Content="Open folder" Click="OnOpenDataFolderClick" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Header="Source and issues"
                Description="github.com/hoobio/steward-companion"
                IsClickEnabled="True"
                Click="OnRepositoryClick">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE943;" />
                </controls:SettingsCard.HeaderIcon>
                <controls:SettingsCard.ActionIcon>
                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                </controls:SettingsCard.ActionIcon>
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
