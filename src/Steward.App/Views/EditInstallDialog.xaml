<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Steward.App.Views.EditInstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Steward.App.ViewModels"
    Title="Edit install"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonClick="OnSaveClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">440</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">480</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="16">
        <StackPanel Spacing="6">
            <TextBox x:Name="NameBox" Header="Name" />
            <TextBlock
                Text="Shown in the install picker. Leave empty to use the game version name."
                FontSize="12"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <StackPanel Spacing="6">
            <ComboBox
                x:Name="GameVersionBox"
                Header="Game version"
                PlaceholderText="Choose a game version"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnGameVersionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameVersionOption">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                Source="{x:Bind Icon}"
                                Visibility="{x:Bind IconVisibility}" />
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock
                x:Name="GameVersionHint"
                FontSize="12"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                x:Name="GameVersionError"
                Text="Choose a game version so Steward installs the right addon builds."
                FontSize="12"
                TextWrapping="Wrap"
                Visibility="Collapsed"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Folder" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Height="32" CornerRadius="4" Padding="10,0,6,0" Background="{ThemeResource ChipBrush}">
                    <TextBlock
                        x:Name="FolderText"
                        VerticalAlignment="Center"
                        FontFamily="Cascadia Mono"
                        FontSize="11.5"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <Button Grid.Column="1" Content="Change" Click="OnChangeFolderClick" />
            </Grid>
            <TextBlock
                x:Name="FolderError"
                FontSize="12"
                TextWrapping="Wrap"
                Visibility="Collapsed"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>

        <TextBlock
            x:Name="BusyNote"
            Text="An update is running on this install. Wait for it to finish before changing the game version or folder."
            FontSize="12"
            TextWrapping="Wrap"
            Visibility="Collapsed"
            Foreground="{ThemeResource SystemFillColorCautionBrush}" />
    </StackPanel>
</ContentDialog>
