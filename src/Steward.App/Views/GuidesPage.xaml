<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Steward.App.Views.GuidesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Steward.App.Views"
    xmlns:vm="using:Steward.App.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="GuideRowTemplate" x:DataType="vm:GuideRowViewModel">
            <Grid
                Background="{x:Bind RowBackground, Mode=OneWay}"
                BorderThickness="{x:Bind HairlineThickness}"
                BorderBrush="{ThemeResource RowHairlineBrush}"
                Padding="16,12"
                ColumnSpacing="14"
                ToolTipService.ToolTip="{x:Bind RowTooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox
                    Grid.Column="0"
                    MinWidth="0"
                    Padding="0"
                    VerticalAlignment="Center"
                    IsEnabled="{x:Bind IsAllowed}"
                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />

                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ProductName}" FontSize="13.5" TextWrapping="NoWrap" Foreground="{x:Bind NameBrush}" />
                    <TextBlock
                        Text="{x:Bind UpdatedText}"
                        FontSize="12"
                        Foreground="{x:Bind UpdatedBrush}"
                        Visibility="{x:Bind UpdatedVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind MessageText, Mode=OneWay}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{x:Bind MessageBrush, Mode=OneWay}"
                        Visibility="{x:Bind MessageVisibility, Mode=OneWay}" />
                </StackPanel>

                <Border
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    CornerRadius="4"
                    Padding="9,3"
                    Background="{ThemeResource ChipBrush}"
                    Visibility="{x:Bind PillVisibility, Mode=OneWay}">
                    <TextBlock
                        Text="{x:Bind PillText, Mode=OneWay}"
                        FontSize="11.5"
                        Foreground="{x:Bind PillBrush, Mode=OneWay}" />
                </Border>

                <Button
                    Grid.Column="3"
                    Height="32"
                    Content="Retry"
                    VerticalAlignment="Center"
                    Command="{x:Bind RetryCommand}"
                    Visibility="{x:Bind RetryVisibility, Mode=OneWay}" />

                <Grid
                    Grid.Row="1"
                    Grid.ColumnSpan="4"
                    Margin="0,10,0,0"
                    Visibility="{x:Bind ProgressVisibility, Mode=OneWay}">
                    <Border Height="3" CornerRadius="2" Background="{ThemeResource ChipBrush}" />
                    <ProgressBar Height="3" IsIndeterminate="True" />
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PageGutter}" Spacing="10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="RestedXP Guides" FontSize="26" FontWeight="SemiBold" Margin="{StaticResource PageTitleMargin}" />
                    <Grid HorizontalAlignment="Left" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{x:Bind ViewModel.RestedXp.SignedInAs, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" /><Run Text="{x:Bind ViewModel.RestedXp.SubtitleDetails, Mode=OneWay}" />
                        </TextBlock>
                        <HyperlinkButton
                            Grid.Column="1"
                            Content="Sign out"
                            Padding="4,0"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.RestedXp.SignOutCommand, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        Text="WoW is running, /reload to load new guides"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Visibility="{x:Bind ViewModel.SelectedGuide.ReloadNoticeVisibility(ViewModel.SelectedInstall.Client, ViewModel.SelectedGuide.WrittenAt), Mode=OneWay, FallbackValue=Collapsed}" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Refresh"
                    ToolTipService.ToolTip="Check now"
                    Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}">
                    <FontIcon
                        Glyph="&#xE72C;"
                        FontSize="14"
                        views:Spinner.IsSpinning="{x:Bind ViewModel.RefreshCommand.IsRunning, Mode=OneWay, FallbackValue=False}" />
                </Button>
            </Grid>

            <views:BannerList Banners="{x:Bind ViewModel.Banners, Mode=OneWay}" />

            <InfoBar
                x:Name="SessionExpiredBar"
                Severity="Warning"
                IsClosable="True"
                CornerRadius="8"
                CloseButtonClick="OnSessionBarClosed"
                IsOpen="{x:Bind ViewModel.RestedXp.IsSessionExpired, Mode=OneWay}"
                Message="Your RestedXP session expired. Sign in again.">
                <InfoBar.ActionButton>
                    <Button Content="Sign in" Click="OnSignInClick" />
                </InfoBar.ActionButton>
            </InfoBar>

            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.SelectedGuideVisibility, Mode=OneWay}">
                <TextBlock
                    Text="KEEP IN GAME"
                    Margin="16,0,0,0"
                    FontSize="11"
                    FontWeight="SemiBold"
                    CharacterSpacing="70"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Visibility="{x:Bind ViewModel.SelectedGuide.RowsVisibility, Mode=OneWay, FallbackValue=Collapsed}" />

                <Border CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel>
                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.SelectedGuide.Rows, Mode=OneWay, FallbackValue={x:Null}}"
                            ItemTemplate="{StaticResource GuideRowTemplate}"
                            IsEnabled="{x:Bind ViewModel.SelectedGuide.IsSessionActive, Mode=OneWay, FallbackValue=False}" />
                        <Border Padding="16,14" Visibility="{x:Bind ViewModel.SelectedGuide.NoGuidesVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    Text="No guides on this account"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <HyperlinkButton
                                    Content="Browse guides"
                                    Padding="4,0"
                                    VerticalAlignment="Center"
                                    NavigateUri="https://shop.restedxp.com/guides/" />
                            </StackPanel>
                        </Border>

                        <Grid
                            BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource RowHairlineBrush}"
                            Padding="{StaticResource CardRowPadding}"
                            MinHeight="{StaticResource CardRowMinHeight}"
                            ColumnSpacing="12"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SelectedGuide.GuidesFilePath, Mode=OneWay, FallbackValue=''}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Glyph="&#xE8A5;"
                                FontSize="16"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="Guides.lua" FontFamily="Cascadia Mono" FontSize="11.5" /><Run Text="{x:Bind ViewModel.SelectedGuide.WrittenText, Mode=OneWay, FallbackValue=''}" />
                            </TextBlock>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    IsActive="{x:Bind ViewModel.RestedXp.WriteAgainCommand.IsRunning, Mode=OneWay}" />
                                <Button
                                    Height="32"
                                    Content="Write again"
                                    Command="{x:Bind ViewModel.RestedXp.WriteAgainCommand, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border
                CornerRadius="8"
                Padding="16,14"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.GuidesNotInstalledVisibility, Mode=OneWay}">
                <TextBlock
                    Text="{x:Bind ViewModel.GuidesNotInstalledText, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
