<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Steward.App.Views.AddonFoldersDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Close"
    DefaultButton="Close">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="12" MinWidth="360">
        <TextBlock x:Name="Caption" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <StackPanel x:Name="Rows" Spacing="12" />
    </StackPanel>
</ContentDialog>
