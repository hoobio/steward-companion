<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Steward.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:services="using:Steward.App.Services"
    xmlns:views="using:Steward.App.Views"
    xmlns:vm="using:Steward.App.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="AddonRowTemplate" x:DataType="vm:AddonRowViewModel">
            <Grid
                Padding="16,8"
                MinHeight="{StaticResource CardRowMinHeight}"
                ColumnSpacing="12"
                Background="Transparent"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource RowHairlineBrush}"
                Tag="{x:Bind}">
                <Grid.Resources>
                    <MenuFlyout
                        x:Key="RowMenu"
                        Placement="BottomEdgeAlignedRight"
                        ShouldConstrainToRootBounds="False"
                        MenuFlyoutPresenterStyle="{StaticResource TintedMenuFlyoutPresenterStyle}">
                        <MenuFlyout.SystemBackdrop>
                            <services:TintedAcrylicBackdrop />
                        </MenuFlyout.SystemBackdrop>
                        <MenuFlyoutItem Text="{x:Bind IgnoreLabel, Mode=OneWay}" Command="{x:Bind ToggleIgnoredCommand}" Visibility="{x:Bind IgnoreVisibility, Mode=OneWay}" />
                        <MenuFlyoutItem Text="Change channel" Command="{x:Bind ChangeChannelCommand}" Visibility="{x:Bind ChannelChipVisibility, Mode=OneWay}" />
                        <MenuFlyoutItem Text="{x:Bind HideLabel, Mode=OneWay}" Command="{x:Bind ToggleHiddenCommand}" Visibility="{x:Bind HideVisibility, Mode=OneWay}" />
                        <MenuFlyoutItem Text="Open folder" Command="{x:Bind OpenFolderCommand}" Visibility="{x:Bind InstalledActionsVisibility, Mode=OneWay}" />
                        <MenuFlyoutItem Text="Reinstall" Command="{x:Bind ReinstallCommand}" Visibility="{x:Bind ReleaseActionsVisibility, Mode=OneWay}" />
                        <MenuFlyoutItem
                            Text="Unmanage addon"
                            ToolTipService.ToolTip="Steward will stop managing updates for this addon and treat it like a local install"
                            Command="{x:Bind UnmanageCommand}"
                            Visibility="{x:Bind UnmanageVisibility, Mode=OneWay}" />
                        <MenuFlyoutSeparator Visibility="{x:Bind UninstallVisibility, Mode=OneWay}" />
                        <MenuFlyoutItem
                            Text="Uninstall"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Command="{x:Bind UninstallCommand}"
                            Visibility="{x:Bind UninstallVisibility, Mode=OneWay}">
                            <MenuFlyoutItem.Resources>
                                <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
                                <StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="SystemFillColorCriticalBrush" />
                            </MenuFlyoutItem.Resources>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.Resources>
                <Grid.ContextFlyout>
                    <StaticResource ResourceKey="RowMenu" />
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="30"
                    Height="30"
                    VerticalAlignment="Center"
                    CornerRadius="6"
                    Background="{ThemeResource ChipBrush}">
                    <Grid>
                        <TextBlock
                            Text="{x:Bind Initials}"
                            FontSize="12"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{x:Bind InitialsBrush}" />
                        <Image Source="{x:Bind FallbackIcon, Mode=OneWay}" Stretch="UniformToFill" />
                        <Image
                            Source="{x:Bind Icon}"
                            Stretch="UniformToFill"
                            Tag="{x:Bind}"
                            ImageFailed="OnManifestIconFailed"
                            Visibility="{x:Bind ManifestIconVisibility, Mode=OneWay}" />
                    </Grid>
                </Border>

                <ProgressBar
                    Grid.ColumnSpan="7"
                    Margin="0,0,0,-6"
                    VerticalAlignment="Bottom"
                    Maximum="1"
                    Value="{x:Bind UpdateProgress, Mode=OneWay}"
                    Visibility="{x:Bind UpdatingVisibility, Mode=OneWay}" />

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <Grid HorizontalAlignment="Left" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{x:Bind DisplayName}"
                            views:MatchHighlight.Match="{x:Bind NameMatch, Mode=OneWay}"
                            FontSize="13.5"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind DisplayName}"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Width="22"
                            Height="22"
                            MinHeight="0"
                            Padding="0"
                            AutomationProperties.Name="Out of date for this client"
                            ToolTipService.ToolTip="{x:Bind OutOfDateTip, Mode=OneWay}"
                            Visibility="{x:Bind OutOfDateVisibility, Mode=OneWay}">
                            <Button.Resources>
                                <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                            </Button.Resources>
                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </Button>
                    </Grid>
                    <Grid HorizontalAlignment="Left" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{x:Bind FolderName}"
                            FontFamily="Cascadia Mono"
                            FontSize="11"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <HyperlinkButton
                            Grid.Column="1"
                            Padding="2,0"
                            MinHeight="0"
                            FontFamily="Cascadia Mono"
                            FontSize="11"
                            VerticalAlignment="Center"
                            Content="{x:Bind ExtraFoldersText, Mode=OneWay}"
                            AutomationProperties.Name="Show the other installed folders"
                            Click="OnExtraFoldersClick"
                            Tag="{x:Bind}"
                            Visibility="{x:Bind ExtraFoldersVisibility, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        Text="/reload in-game to update"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Visibility="{x:Bind ReloadHintVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind StatusMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Visibility="{x:Bind FailedMessageVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind UninstallError, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Visibility="{x:Bind UninstallErrorVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind StatusMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind NoticeVisibility, Mode=OneWay}" />
                </StackPanel>

                <ContentControl
                    Grid.Column="2"
                    IsTabStop="{x:Bind HasVersionCellTip, Mode=OneWay}"
                    UseSystemFocusVisuals="True"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind VersionCellTip, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind VersionCellTip, Mode=OneWay}">
                    <StackPanel Spacing="2">
                        <TextBlock
                            FontSize="12"
                            TextWrapping="NoWrap"
                            SizeChanged="OnVersionSizeChanged"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind StackedVersionPairVisibility, Mode=OneWay}">
                            <Run Text="{x:Bind NotInstalledRunText, Mode=OneWay}" /><Run Text="{x:Bind InstalledRunText, Mode=OneWay}" FontFamily="Cascadia Mono" FontSize="11.5" />
                        </TextBlock>
                        <Button
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            MinHeight="0"
                            Margin="-4,0,0,0"
                            Padding="4,2"
                            IsEnabled="{x:Bind HasChangelog, Mode=OneWay}"
                            AutomationProperties.Name="Changelog"
                            ToolTipService.ToolTip="{x:Bind VersionButtonTip, Mode=OneWay}"
                            Tag="{x:Bind}"
                            Click="OnChangelogClick">
                            <Button.Resources>
                                <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                            </Button.Resources>
                            <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="VersionPair"
                                FontSize="12"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"
                                SizeChanged="OnVersionSizeChanged"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="{x:Bind WideVersionPairVisibility, Mode=OneWay}">
                                <Run Text="{x:Bind NotInstalledRunText, Mode=OneWay}" /><Run Text="{x:Bind InstalledRunText, Mode=OneWay}" FontFamily="Cascadia Mono" FontSize="11.5" /><Run Text=" &#x2192; " /><Run Text="{x:Bind AvailableVersionShort, Mode=OneWay}" FontFamily="Cascadia Mono" FontSize="11.5" Foreground="{x:Bind NewVersionBrush, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                FontSize="12"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"
                                SizeChanged="OnVersionSizeChanged"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="{x:Bind StackedVersionPairVisibility, Mode=OneWay}">
                                <Run Text="&#x2192; " /><Run Text="{x:Bind AvailableVersionShort, Mode=OneWay}" FontFamily="Cascadia Mono" FontSize="11.5" Foreground="{x:Bind NewVersionBrush, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                Text="{x:Bind InstalledVersionShort, Mode=OneWay}"
                                FontFamily="Cascadia Mono"
                                FontSize="11.5"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind CurrentVersionVisibility, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind AvailableVersionShort, Mode=OneWay}"
                                FontFamily="Cascadia Mono"
                                FontSize="11.5"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AvailableVersionBrush}"
                                Visibility="{x:Bind UpdatingVisibility, Mode=OneWay}" />
                            <!-- E8FD's own ink sits ~1.2px above the version text's ink centre (measured via screenshot pixel scan); nudged down to match. -->
                            <FontIcon
                                x:Name="ChangelogIcon"
                                Grid.Column="1"
                                Width="12"
                                Glyph="&#xE8FD;"
                                FontSize="12"
                                Margin="0,1,0,0"
                                VerticalAlignment="Center"
                                SizeChanged="OnVersionSizeChanged"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind HasChangelog, Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <TextBlock
                            Text="{x:Bind ReleasedText, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ReleasedTip, Mode=OneWay}"
                            FontSize="11.5"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ReleasedVisibility, Mode=OneWay}" />
                        <TextBlock
                            Text="No releases yet"
                            FontSize="12.5"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind NoReleasesVisibility, Mode=OneWay}" />
                        <Button
                            Height="24"
                            MinHeight="0"
                            Padding="8,0,6,0"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource ChipBrush}"
                            Command="{x:Bind ChangeChannelCommand}"
                            AutomationProperties.Name="Release channel"
                            Visibility="{x:Bind CompactChannelChipVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Channel, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE70D;" FontSize="9" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Button>
                        <ContentControl
                            IsTabStop="True"
                            UseSystemFocusVisuals="True"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="{x:Bind SingleChannelTip, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind SingleChannelTip, Mode=OneWay}"
                            Visibility="{x:Bind CompactSingleChannelVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Channel, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ContentControl>
                    </StackPanel>
                </ContentControl>

                <Button
                    Grid.Column="3"
                    Height="24"
                    MinHeight="0"
                    Padding="8,0,6,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ChipBrush}"
                    Command="{x:Bind ChangeChannelCommand}"
                    AutomationProperties.Name="Release channel"
                    Visibility="{x:Bind ChannelChipVisibility, Mode=OneWay}">
                    <Button.RenderTransform>
                        <TranslateTransform X="-8" />
                    </Button.RenderTransform>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind Channel, Mode=OneWay}" FontSize="12" />
                        <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Button>
                <ContentControl
                    Grid.Column="3"
                    IsTabStop="True"
                    UseSystemFocusVisuals="True"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="{x:Bind SingleChannelTip, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind SingleChannelTip, Mode=OneWay}"
                    Visibility="{x:Bind SingleChannelVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Channel, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </ContentControl>
                <TextBlock
                    Grid.Column="3"
                    Text="-"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Visibility="{x:Bind NoChannelVisibility, Mode=OneWay}" />

                <TextBlock
                    Grid.Column="4"
                    Text="{x:Bind Source}"
                    TextTrimming="CharacterEllipsis"
                    FontSize="12.5"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Grid Grid.Column="5" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind StatusText, Mode=OneWay}"
                        FontSize="12.5"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"
                        Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                        Visibility="{x:Bind StatusTextVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="Up to date"
                        FontSize="12.5"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        ToolTipService.ToolTip="Up to date"
                        Visibility="{x:Bind UpToDateVisibility, Mode=OneWay}" />
                    <StackPanel VerticalAlignment="Center" Visibility="{x:Bind IgnoredStatusVisibility, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="Updates ignored" FontSize="12.5" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </StackPanel>
                        <TextBlock
                            Text="Update available"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind IgnoredUpdateVisibility, Mode=OneWay}" />
                    </StackPanel>
                    <Border
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        Padding="8,2"
                        Background="{ThemeResource ChipBrush}"
                        Visibility="{x:Bind HiddenPillVisibility, Mode=OneWay}">
                        <TextBlock Text="Hidden" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Button
                        Height="32"
                        HorizontalAlignment="Left"
                        Content="{x:Bind ActionLabel, Mode=OneWay}"
                        Style="{x:Bind ActionStyle, Mode=OneWay}"
                        Command="{x:Bind UpdateCommand}"
                        Visibility="{x:Bind ActionVisibility, Mode=OneWay}" />
                    <Button Height="32" HorizontalAlignment="Left" Content="Retry" Command="{x:Bind UpdateCommand}" Visibility="{x:Bind FailedVisibility, Mode=OneWay}" />
                    <Button
                        Height="32"
                        HorizontalAlignment="Left"
                        Content="Sign in to RestedXP"
                        Command="{x:Bind RestedXpSignInCommand}"
                        Visibility="{x:Bind RestedXpSignInVisibility, Mode=OneWay}" />
                </Grid>

                <Button
                    Grid.Column="6"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="More options"
                    ToolTipService.ToolTip="More"
                    Flyout="{StaticResource RowMenu}"
                    Visibility="{x:Bind OverflowVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LocalRowTemplate" x:DataType="vm:LocalAddonRowViewModel">
            <Grid
                Padding="16,8"
                MinHeight="{StaticResource CardRowMinHeight}"
                ColumnSpacing="12"
                Background="Transparent"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource RowHairlineBrush}"
                Tag="{x:Bind}">
                <Grid.Resources>
                    <MenuFlyout
                        x:Key="RowMenu"
                        Placement="BottomEdgeAlignedRight"
                        ShouldConstrainToRootBounds="False"
                        MenuFlyoutPresenterStyle="{StaticResource TintedMenuFlyoutPresenterStyle}">
                        <MenuFlyout.SystemBackdrop>
                            <services:TintedAcrylicBackdrop />
                        </MenuFlyout.SystemBackdrop>
                        <MenuFlyoutItem Text="Adopt from CurseForge" Command="{x:Bind AdoptCommand}" Visibility="{x:Bind AdoptFromMenuVisibility, Mode=OneWay}" />
                        <MenuFlyoutItem Text="{x:Bind HideLabel, Mode=OneWay}" Command="{x:Bind ToggleHiddenCommand}" />
                        <MenuFlyoutItem Text="Open folder" Command="{x:Bind OpenFolderCommand}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            Text="Uninstall"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Command="{x:Bind UninstallCommand}">
                            <MenuFlyoutItem.Resources>
                                <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
                                <StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="SystemFillColorCriticalBrush" />
                            </MenuFlyoutItem.Resources>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.Resources>
                <Grid.ContextFlyout>
                    <StaticResource ResourceKey="RowMenu" />
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="30"
                    Height="30"
                    VerticalAlignment="Center"
                    CornerRadius="6"
                    Background="{ThemeResource ChipBrush}">
                    <Grid>
                        <TextBlock
                            Text="{x:Bind Initials}"
                            FontSize="12"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{x:Bind InitialsBrush}" />
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <Grid HorizontalAlignment="Left" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{x:Bind DisplayName}"
                            views:MatchHighlight.Match="{x:Bind NameMatch, Mode=OneWay}"
                            FontSize="13.5"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind DisplayName}"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Width="22"
                            Height="22"
                            MinHeight="0"
                            Padding="0"
                            AutomationProperties.Name="Out of date for this client"
                            ToolTipService.ToolTip="{x:Bind OutOfDateTip}"
                            Visibility="{x:Bind OutOfDateVisibility}">
                            <Button.Resources>
                                <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                            </Button.Resources>
                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </Button>
                    </Grid>
                    <Grid HorizontalAlignment="Left" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{x:Bind FolderName}"
                            FontFamily="Cascadia Mono"
                            FontSize="11"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <HyperlinkButton
                            Grid.Column="1"
                            Padding="2,0"
                            MinHeight="0"
                            FontFamily="Cascadia Mono"
                            FontSize="11"
                            VerticalAlignment="Center"
                            Content="{x:Bind ExtraFoldersText}"
                            AutomationProperties.Name="Show the other installed folders"
                            Click="OnExtraFoldersClick"
                            Tag="{x:Bind}"
                            Visibility="{x:Bind ExtraFoldersVisibility}" />
                    </Grid>
                    <TextBlock
                        Text="{x:Bind FailureMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Visibility="{x:Bind FailedVisibility, Mode=OneWay}" />
                </StackPanel>

                <ContentControl
                    Grid.Column="2"
                    IsTabStop="{x:Bind HasVersionTip, Mode=OneWay}"
                    UseSystemFocusVisuals="True"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="{x:Bind VersionTip, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind VersionTip, Mode=OneWay}">
                    <TextBlock
                        Text="{x:Bind Version}"
                        FontFamily="Cascadia Mono"
                        FontSize="11.5"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </ContentControl>

                <TextBlock
                    Grid.Column="3"
                    Text="-"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <TextBlock
                    Grid.Column="4"
                    Text="{x:Bind Source}"
                    TextTrimming="CharacterEllipsis"
                    FontSize="12.5"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <TextBlock
                    Grid.Column="5"
                    Text="-"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Visibility="{x:Bind StatusDashVisibility, Mode=OneWay}" />
                <Border
                    Grid.Column="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CornerRadius="4"
                    Padding="8,2"
                    Background="{ThemeResource ChipBrush}"
                    Visibility="{x:Bind HiddenPillVisibility, Mode=OneWay}">
                    <TextBlock Text="Hidden" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <Button
                    Grid.Column="5"
                    Height="32"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CornerRadius="4"
                    FontWeight="SemiBold"
                    Content="Adopt"
                    AutomationProperties.Name="{x:Bind AdoptAccessibleName}"
                    Command="{x:Bind AdoptCommand}"
                    Visibility="{x:Bind AdoptVisibility, Mode=OneWay}">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackground" ResourceKey="CautionButtonBackground" />
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="CautionButtonBackgroundPointerOver" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CautionButtonBackgroundPressed" />
                        <StaticResource x:Key="ButtonForeground" ResourceKey="CautionButtonForeground" />
                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="CautionButtonForeground" />
                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="CautionButtonForeground" />
                    </Button.Resources>
                </Button>

                <Button
                    Grid.Column="6"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="More options"
                    ToolTipService.ToolTip="More"
                    Flyout="{StaticResource RowMenu}">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                </Button>
            </Grid>
        </DataTemplate>

        <views:AddonTableTemplateSelector
            x:Key="AddonTableTemplateSelector"
            Addon="{StaticResource AddonRowTemplate}"
            Local="{StaticResource LocalRowTemplate}" />
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowPage">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CheckedLabel.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WidePage">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="26,7,26,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="Addons"
                FontSize="28"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />

            <Button
                Grid.Column="1"
                Height="32"
                VerticalAlignment="Center"
                Click="OnGetAddonsClick"
                AutomationProperties.Name="Get addons"
                Visibility="{x:Bind ViewModel.GetAddonsVisibility, Mode=OneWay}">
                <Button.Resources>
                    <StaticResource x:Key="ButtonBackground" ResourceKey="ControlFillColorDefaultBrush" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ControlFillColorSecondaryBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ControlFillColorTertiaryBrush" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE710;" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="Get addons" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <views:BannerList
            Grid.Row="1"
            Margin="26,10,26,0"
            Banners="{x:Bind ViewModel.Banners, Mode=OneWay}" />

        <ScrollViewer Grid.Row="2">
            <StackPanel Padding="26,10,26,26" Spacing="10">
                <Border
                    CornerRadius="8"
                    Padding="12,8"
                    Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
                    Visibility="{x:Bind ViewModel.AppUpdateVisibility, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.AppUpdateIdleVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.AppUpdateTitle, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <HyperlinkButton Content="View changelog" Padding="4,0" NavigateUri="{x:Bind ViewModel.AppUpdateChangelogUri, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.AppUpdateProgressVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.AppUpdateProgress.Text, Mode=OneWay}" FontWeight="SemiBold" />
                            <ProgressBar
                                Maximum="100"
                                Value="{x:Bind ViewModel.AppUpdateProgress.Percent, Mode=OneWay}"
                                IsIndeterminate="{x:Bind ViewModel.AppUpdateProgress.IsIndeterminate, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Height="32"
                            Content="{x:Bind ViewModel.AppUpdateActionLabel, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.InstallAppUpdateCommand}" />
                    </Grid>
                </Border>

                <Border
                    CornerRadius="8"
                    Padding="12,8"
                    Background="{ThemeResource CriticalTintBrush}"
                    Visibility="{x:Bind ViewModel.StatusMessageIsOpen, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE783;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                        <Button
                            Grid.Column="2"
                            Height="28"
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Content="{x:Bind ViewModel.StatusActionLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.StatusActionCommand}"
                            Visibility="{x:Bind ViewModel.StatusActionVisibility, Mode=OneWay}" />
                    </Grid>
                </Border>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="220" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.TableVisibility, Mode=OneWay}">
                        <TextBox
                            Height="32"
                            Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Filter addons"
                            Padding="32,6,10,6"
                            AutomationProperties.Name="Filter addons" />
                        <FontIcon
                            Glyph="&#xE721;"
                            FontSize="13"
                            Margin="11,0,0,0"
                            HorizontalAlignment="Left"
                            IsHitTestVisible="False"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>

                    <controls:Segmented
                        Grid.Column="1"
                        SelectionMode="Single"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.TableVisibility, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}">
                        <controls:SegmentedItem Content="All" />
                        <controls:SegmentedItem AutomationProperties.Name="{x:Bind ViewModel.UpdatesSegmentLabel, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Updates" VerticalAlignment="Center" />
                                <Border
                                    MinWidth="18"
                                    Height="18"
                                    Padding="5,0"
                                    CornerRadius="9"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{x:Bind ViewModel.UpdatesBadgeVisibility, Mode=OneWay}">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.SelectedUpdateCountText, Mode=OneWay}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                        </controls:SegmentedItem>
                        <controls:SegmentedItem
                            AutomationProperties.Name="{x:Bind ViewModel.HiddenSegmentLabel, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HiddenSegmentVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Hidden" VerticalAlignment="Center" />
                                <Border
                                    MinWidth="18"
                                    Height="18"
                                    Padding="5,0"
                                    CornerRadius="9"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ChipBrush}">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.HiddenCountText, Mode=OneWay}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </controls:SegmentedItem>
                    </controls:Segmented>

                    <Button
                        Grid.Column="2"
                        Height="32"
                        Content="Default order"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.DefaultOrderCommand}"
                        Visibility="{x:Bind ViewModel.DefaultOrderVisibility, Mode=OneWay}" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="CheckedLabel"
                            Text="{x:Bind ViewModel.CheckedText, Mode=OneWay}"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Visibility="{x:Bind ViewModel.CheckedStaleVisibility, Mode=OneWay}" />

                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            AutomationProperties.Name="Check for updates"
                            ToolTipService.ToolTip="{x:Bind ViewModel.CheckedText, Mode=OneWay}">
                            <FontIcon
                                Glyph="&#xE72C;"
                                FontSize="14"
                                views:Spinner.IsSpinning="{x:Bind ViewModel.RefreshCommand.IsRunning, Mode=OneWay}" />
                        </Button>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="1"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.UpdateAllVisibility, Mode=OneWay}">
                            <Button
                                Height="32"
                                CornerRadius="4,0,0,4"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="{x:Bind ViewModel.UpdateAllOnInstallAccessibleName, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.UpdateAllEnabled, Mode=OneWay}"
                                Click="OnUpdateAllClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="Update all" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="UpdateAllMore"
                                Width="34"
                                Height="32"
                                Padding="0"
                                CornerRadius="0,4,4,0"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="More update options"
                                IsEnabled="{x:Bind ViewModel.UpdateAllEnabled, Mode=OneWay}">
                                <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                <Button.Flyout>
                                    <MenuFlyout
                                        Placement="BottomEdgeAlignedRight"
                                        ShouldConstrainToRootBounds="False"
                                        MenuFlyoutPresenterStyle="{StaticResource TintedMenuFlyoutPresenterStyle}">
                                        <MenuFlyout.SystemBackdrop>
                                            <services:TintedAcrylicBackdrop />
                                        </MenuFlyout.SystemBackdrop>
                                        <MenuFlyoutItem
                                            Text="{x:Bind ViewModel.UpdateAllOnInstallLabel, Mode=OneWay}"
                                            KeyboardAcceleratorTextOverride="{x:Bind ViewModel.SelectedUpdateCountText, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind ViewModel.UpdateAllOnInstallAccessibleName, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.UpdateAllCommand}" />
                                        <MenuFlyoutItem
                                            Text="Update all installs"
                                            KeyboardAcceleratorTextOverride="{x:Bind ViewModel.TotalUpdateCountText, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind ViewModel.UpdateAllInstallsAccessibleName, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.UpdateAllInstallsCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="1"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.AdoptAllVisibility, Mode=OneWay}">
                            <StackPanel.Resources>
                                <StaticResource x:Key="ButtonBackground" ResourceKey="CautionButtonBackground" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="CautionButtonBackgroundPointerOver" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CautionButtonBackgroundPressed" />
                                <StaticResource x:Key="ButtonForeground" ResourceKey="CautionButtonForeground" />
                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="CautionButtonForeground" />
                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="CautionButtonForeground" />
                            </StackPanel.Resources>
                            <Button
                                Height="32"
                                CornerRadius="4,0,0,4"
                                FontWeight="SemiBold"
                                AutomationProperties.Name="{x:Bind ViewModel.AdoptAllAccessibleName, Mode=OneWay}"
                                Command="{x:Bind ViewModel.AdoptAllCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="Adopt all" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                Width="34"
                                Height="32"
                                Padding="0"
                                CornerRadius="0,4,4,0"
                                AutomationProperties.Name="More adopt options">
                                <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                <Button.Flyout>
                                    <MenuFlyout
                                        Placement="BottomEdgeAlignedRight"
                                        ShouldConstrainToRootBounds="False"
                                        MenuFlyoutPresenterStyle="{StaticResource TintedMenuFlyoutPresenterStyle}">
                                        <MenuFlyout.SystemBackdrop>
                                            <services:TintedAcrylicBackdrop />
                                        </MenuFlyout.SystemBackdrop>
                                        <MenuFlyoutItem Text="Adopt none" Command="{x:Bind ViewModel.AdoptNoneCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border
                    Margin="0,10,0,0"
                    CornerRadius="8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    Visibility="{x:Bind ViewModel.TableVisibility, Mode=OneWay}">
                    <StackPanel x:Name="TableBody" SizeChanged="OnTableSizeChanged">
                        <Grid
                            x:Name="TableHeader"
                            Padding="16,6"
                            ColumnSpacing="12"
                            CornerRadius="{StaticResource GroupTopCornerRadius}"
                            Background="{ThemeResource LayerFillColorAltBrush}">
                            <Grid.Resources>
                                <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="1"
                                Height="26"
                                MinHeight="0"
                                Padding="4,0"
                                Margin="-4,0,0,0"
                                Command="{x:Bind ViewModel.SortByCommand}"
                                CommandParameter="name">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Name" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <FontIcon Glyph="{x:Bind ViewModel.NameSortGlyph, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="2"
                                Height="26"
                                MinHeight="0"
                                Padding="4,0"
                                Margin="-4,0,0,0"
                                AutomationProperties.Name="Sort by last updated"
                                Command="{x:Bind ViewModel.SortByCommand}"
                                CommandParameter="version">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Version" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <FontIcon Glyph="{x:Bind ViewModel.VersionSortGlyph, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="3" Text="Channel" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button
                                Grid.Column="4"
                                Height="26"
                                MinHeight="0"
                                Padding="4,0"
                                Margin="-4,0,0,0"
                                Command="{x:Bind ViewModel.SortByCommand}"
                                CommandParameter="source">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Source" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <FontIcon Glyph="{x:Bind ViewModel.SourceSortGlyph, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="5"
                                Height="26"
                                MinHeight="0"
                                Padding="4,0"
                                Margin="-4,0,0,0"
                                Command="{x:Bind ViewModel.SortByCommand}"
                                CommandParameter="status">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Status" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <FontIcon Glyph="{x:Bind ViewModel.StatusSortGlyph, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ItemsRepeater
                            x:Name="TableRepeater"
                            ItemsSource="{x:Bind ViewModel.TableRows}"
                            ItemTemplate="{StaticResource AddonTableTemplateSelector}"
                            ElementPrepared="OnTableRowPrepared"
                            ElementClearing="OnTableRowClearing" />

                        <TextBlock
                            Text="No addons match"
                            Padding="0,28"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.NoMatchVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="460"
            Spacing="12"
            Visibility="{x:Bind ViewModel.GameVersionPromptVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xE7BA;" FontSize="36" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            <TextBlock
                Text="Choose a game version for this install"
                FontSize="16"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                TextAlignment="Center" />
            <TextBlock
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Steward needs to know which game this folder runs so it installs the matching addon builds. Folders added by hand have no .flavor.info to read it from." />
            <Button
                Height="32"
                HorizontalAlignment="Center"
                Content="Choose game version"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.EditInstallCommand}" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="460"
            Spacing="12"
            Visibility="{x:Bind ViewModel.MissingInstallVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xE7BA;" FontSize="36" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            <TextBlock
                Text="Folder not found"
                FontSize="16"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                TextAlignment="Center" />
            <TextBlock
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.MissingInstallBody, Mode=OneWay}" />
            <Button
                Height="32"
                HorizontalAlignment="Center"
                Content="Remove"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.RemoveSelectedInstallCommand}" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="460"
            Spacing="12"
            Visibility="{x:Bind ViewModel.NoInstallsVisibility, Mode=OneWay}">
            <FontIcon
                Glyph="&#xE8B7;"
                FontSize="44"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                Text="No World of Warcraft installs found"
                FontSize="20"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                TextAlignment="Center" />
            <TextBlock
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Steward finds a World of Warcraft: Forever folder by its .flavor.info, such as _classic_beta_." />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button
                    Height="32"
                    Content="Add install"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.BrowseCommand}" />
                <Button Height="32" Content="Rescan" Command="{x:Bind ViewModel.RescanCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
