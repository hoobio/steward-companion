<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Steward.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Steward.App.ViewModels">

    <Page.Resources>
        <SolidColorBrush x:Key="AvailableVersionBrush" Color="{ThemeResource SystemAccentColorLight1}" />

        <DataTemplate x:Key="AddonRowTemplate" x:DataType="vm:AddonRowViewModel">
            <Grid
                BorderThickness="{x:Bind HairlineThickness}"
                BorderBrush="{ThemeResource RowHairlineBrush}"
                Padding="{StaticResource CardRowPadding}"
                MinHeight="{StaticResource CardRowMinHeight}"
                ColumnSpacing="12"
                Visibility="{x:Bind RowVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="30"
                    Height="30"
                    VerticalAlignment="Center"
                    CornerRadius="6"
                    Background="{ThemeResource ChipBrush}">
                    <Grid>
                        <FontIcon
                            Glyph="&#xE7FC;"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Image Source="{x:Bind Icon}" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind DisplayName}"
                        FontSize="13.5"
                        FontWeight="SemiBold"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            Glyph="{x:Bind StatusGlyph, Mode=OneWay}"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Foreground="{x:Bind StatusGlyphBrush, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind StatusGlyphTooltip, Mode=OneWay}"
                            Visibility="{x:Bind StatusGlyphVisibility, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind SubtitleText, Mode=OneWay}"
                            FontFamily="Cascadia Mono"
                            FontSize="11.5"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <TextBlock
                        Text="Type /reload in game to load the updated files"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Visibility="{x:Bind ReloadHintVisibility, Mode=OneWay}" />
                    <ProgressBar
                        Height="3"
                        Maximum="1"
                        Margin="0,4,0,0"
                        Value="{x:Bind UpdateProgress, Mode=OneWay}"
                        Visibility="{x:Bind UpdatingVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind UpdatingLine, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind UpdatingVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind StatusMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Visibility="{x:Bind FailedVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind StatusMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind NoticeVisibility, Mode=OneWay}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind InstalledVersion, Mode=OneWay}"
                        FontFamily="Cascadia Mono"
                        FontSize="12.5"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="{x:Bind VersionPairVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="&#x2192;"
                        FontFamily="Cascadia Mono"
                        FontSize="12.5"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="{x:Bind VersionPairVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind AvailableVersion, Mode=OneWay}"
                        FontFamily="Cascadia Mono"
                        FontSize="12.5"
                        Foreground="{StaticResource AvailableVersionBrush}"
                        Visibility="{x:Bind VersionPairVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="No releases yet"
                        FontFamily="Cascadia Mono"
                        FontSize="12.5"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="{x:Bind NoReleasesVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind ProgressText, Mode=OneWay}"
                        FontFamily="Cascadia Mono"
                        FontSize="12.5"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind UpdatingVisibility, Mode=OneWay}" />
                </StackPanel>

                <Border
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    CornerRadius="10"
                    Padding="8,2"
                    Background="{ThemeResource ChipBrush}"
                    Visibility="{x:Bind ChannelPillVisibility, Mode=OneWay}">
                    <TextBlock
                        Text="{x:Bind Channel, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>

                <StackPanel
                    Grid.Column="4"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        Height="32"
                        Content="{x:Bind ActionLabel, Mode=OneWay}"
                        Style="{x:Bind ActionStyle, Mode=OneWay}"
                        Command="{x:Bind UpdateCommand}"
                        Visibility="{x:Bind ActionVisibility, Mode=OneWay}" />
                    <Button
                        Height="32"
                        Content="Updating"
                        IsEnabled="False"
                        Visibility="{x:Bind UpdatingVisibility, Mode=OneWay}" />
                    <Border
                        VerticalAlignment="Center"
                        CornerRadius="10"
                        Padding="8,2"
                        Background="{ThemeResource CautionTintBrush}"
                        Visibility="{x:Bind MemberPillVisibility, Mode=OneWay}">
                        <TextBlock Text="Update available" FontSize="12" />
                    </Border>
                    <Button Height="32" Content="Retry" Command="{x:Bind UpdateCommand}" Visibility="{x:Bind FailedVisibility, Mode=OneWay}" />
                    <Button
                        Height="32"
                        Content="Sign in to RestedXP"
                        Command="{x:Bind RestedXpSignInCommand}"
                        Visibility="{x:Bind RestedXpSignInVisibility, Mode=OneWay}" />
                    <Border
                        VerticalAlignment="Center"
                        CornerRadius="10"
                        Padding="8,2"
                        Background="{ThemeResource ChipBrush}"
                        Visibility="{x:Bind HiddenPillVisibility, Mode=OneWay}">
                        <TextBlock Text="Hidden" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        ToolTipService.ToolTip="More"
                        Visibility="{x:Bind OverflowVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Change channel" Command="{x:Bind ChangeChannelCommand}" />
                                <MenuFlyoutItem Text="Open folder" Command="{x:Bind OpenFolderCommand}" />
                                <MenuFlyoutItem Text="Reinstall" Command="{x:Bind ReinstallCommand}" />
                                <MenuFlyoutItem Text="Copy SHA-256" Command="{x:Bind CopySha256Command}" />
                                <MenuFlyoutSeparator Visibility="{x:Bind HideVisibility}" />
                                <MenuFlyoutItem Text="{x:Bind HideLabel, Mode=OneWay}" Command="{x:Bind ToggleHiddenCommand}" Visibility="{x:Bind HideVisibility}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="InstallCardTemplate" x:DataType="vm:WowInstallViewModel">
            <Expander
                IsExpanded="True"
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="8"
                BorderThickness="0">
                <Expander.Resources>
                    <Thickness x:Key="ExpanderContentBorderThickness">0</Thickness>
                    <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
                    <Thickness x:Key="ExpanderContentUpBorderThickness">0</Thickness>
                    <Thickness x:Key="ExpanderHeaderPadding">16,0,0,0</Thickness>
                </Expander.Resources>
                <Expander.Header>
                    <Grid ColumnSpacing="12" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    ToolTipService.ToolTip="World of Warcraft is running"
                                    Visibility="{x:Bind RunningDotVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind DisplayName}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind FlavourPath}"
                                FontFamily="Cascadia Mono"
                                FontSize="11.5"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            CornerRadius="4"
                            Padding="6,2"
                            Background="{ThemeResource ChipBrush}">
                            <TextBlock
                                Text="{x:Bind ClientVersion}"
                                FontFamily="Cascadia Mono"
                                FontSize="11.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>

                        <Border
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            CornerRadius="10"
                            Padding="8,2"
                            Background="{x:Bind CountPillBrush, Mode=OneWay}">
                            <TextBlock Text="{x:Bind CountPillText, Mode=OneWay}" FontSize="12" />
                        </Border>

                        <Button Grid.Column="3" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="More">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Open folder" Command="{x:Bind OpenFolderCommand}" />
                                    <MenuFlyoutItem Text="Remove install" Command="{x:Bind RemoveCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Expander.Header>
                <ItemsControl
                    ItemsSource="{x:Bind AddonRows}"
                    ItemTemplate="{StaticResource AddonRowTemplate}" />
            </Expander>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="{StaticResource PageGutter}" Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Addons" FontSize="26" FontWeight="SemiBold" Margin="{StaticResource PageTitleMargin}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.HeaderSubtitle, Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            ToolTipService.ToolTip="Check now">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                        <ToggleButton
                            Height="32"
                            Content="Hidden addons"
                            IsChecked="{x:Bind ViewModel.ShowHiddenAddons, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.HiddenToggleVisibility, Mode=OneWay}" />
                        <Button Height="32" Content="Add install" Command="{x:Bind ViewModel.BrowseCommand}" />
                    </StackPanel>
                </Grid>

                <Border
                    CornerRadius="8"
                    Padding="12,8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
                    Visibility="{x:Bind ViewModel.AppUpdateVisibility, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.AppUpdateTitle, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <HyperlinkButton Content="View changelog" Padding="4,0" NavigateUri="{x:Bind ViewModel.AppUpdateChangelogUri, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Height="32"
                            Content="{x:Bind ViewModel.AppUpdateActionLabel, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.InstallAppUpdateCommand}" />
                    </Grid>
                </Border>

                <InfoBar
                    Severity="Error"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.StatusMessageIsOpen, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.StatusMessageIsOpen, Mode=OneWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Content="Retry" Command="{x:Bind ViewModel.RefreshCommand}" Visibility="{x:Bind ViewModel.RetryVisibility, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Border
                    CornerRadius="8"
                    Padding="16"
                    Background="{x:Bind ViewModel.BannerBrush, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.BannerVisibility, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Glyph="{x:Bind ViewModel.BannerGlyph, Mode=OneWay}" />

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind ViewModel.BannerTitle, Mode=OneWay}"
                                FontSize="19"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="{x:Bind ViewModel.BannerDetail, Mode=OneWay}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                Height="32"
                                Content="Update all"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.UpdateAllCommand}"
                                Visibility="{x:Bind ViewModel.UpdateAllVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ItemsControl
                    ItemsSource="{x:Bind ViewModel.Installs}"
                    ItemTemplate="{StaticResource InstallCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="460"
            Spacing="12"
            Visibility="{x:Bind ViewModel.NoInstallsVisibility, Mode=OneWay}">
            <FontIcon
                Glyph="&#xE8B7;"
                FontSize="44"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                Text="No World of Warcraft installs found"
                FontSize="20"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                TextAlignment="Center" />
            <TextBlock
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Steward finds a World of Warcraft: Forever folder by its .flavor.info, such as _classic_beta_." />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button
                    Height="32"
                    Content="Add install"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.BrowseCommand}" />
                <Button Height="32" Content="Rescan" Command="{x:Bind ViewModel.RescanCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
