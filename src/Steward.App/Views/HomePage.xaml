<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Steward.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:Steward.App.Views"
    xmlns:vm="using:Steward.App.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="InstallOptionTemplate" x:DataType="vm:WowInstallViewModel">
            <Button
                MinHeight="40"
                Padding="8,5"
                BorderThickness="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                ToolTipService.ToolTip="{x:Bind FlavourPath}"
                Click="OnInstallOptionClick">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                        <FontIcon
                            Glyph="&#xE7BA;"
                            FontSize="14"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Visibility="{x:Bind NoGameVersionVisibility}" />
                        <Image Source="{x:Bind ProductIcon}" Stretch="Uniform" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Label}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind GameVersionName}"
                            FontSize="11.5"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind GameVersionLineVisibility}" />
                        <TextBlock
                            Text="Game version not set"
                            FontSize="11.5"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Visibility="{x:Bind NoGameVersionVisibility}" />
                        <TextBlock
                            Text="{x:Bind FlavourPath}"
                            FontFamily="Cascadia Mono"
                            FontSize="11"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <Ellipse
                        Grid.Column="2"
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{x:Bind CurrentDotVisibility, Mode=OneWay}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="AddonRowTemplate" x:DataType="vm:AddonRowViewModel">
            <Grid
                Padding="16,8"
                MinHeight="{StaticResource CardRowMinHeight}"
                ColumnSpacing="12"
                Background="Transparent"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource RowHairlineBrush}"
                SizeChanged="OnTableRowSizeChanged">
                <Grid.Resources>
                    <MenuFlyout x:Key="RowMenu" Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="{x:Bind IgnoreLabel, Mode=OneWay}" Command="{x:Bind ToggleIgnoredCommand}" Visibility="{x:Bind IgnoreVisibility, Mode=OneWay}" />
                        <MenuFlyoutItem Text="Change channel" Command="{x:Bind ChangeChannelCommand}" Visibility="{x:Bind ChannelChipVisibility, Mode=OneWay}" />
                        <MenuFlyoutItem Text="{x:Bind HideLabel, Mode=OneWay}" Command="{x:Bind ToggleHiddenCommand}" Visibility="{x:Bind HideVisibility}" />
                        <MenuFlyoutItem Text="Open folder" Command="{x:Bind OpenFolderCommand}" Visibility="{x:Bind InstalledActionsVisibility, Mode=OneWay}" />
                        <MenuFlyoutItem Text="Reinstall" Command="{x:Bind ReinstallCommand}" Visibility="{x:Bind ReleaseActionsVisibility, Mode=OneWay}" />
                        <MenuFlyoutSeparator Visibility="{x:Bind UninstallVisibility, Mode=OneWay}" />
                        <MenuFlyoutItem
                            Text="Uninstall"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Command="{x:Bind UninstallCommand}"
                            Visibility="{x:Bind UninstallVisibility, Mode=OneWay}">
                            <MenuFlyoutItem.Resources>
                                <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
                                <StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="SystemFillColorCriticalBrush" />
                            </MenuFlyoutItem.Resources>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.Resources>
                <Grid.ContextFlyout>
                    <StaticResource ResourceKey="RowMenu" />
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="3*" MinWidth="96" />
                    <ColumnDefinition Width="2*" MinWidth="114" />
                    <ColumnDefinition Width="1.2*" MinWidth="84" />
                    <ColumnDefinition Width="1*" MinWidth="60" />
                    <ColumnDefinition Width="1.5*" MinWidth="76" />
                    <ColumnDefinition Width="184" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="30"
                    Height="30"
                    VerticalAlignment="Center"
                    CornerRadius="6"
                    Background="{ThemeResource ChipBrush}">
                    <Grid>
                        <TextBlock
                            Text="{x:Bind Initials}"
                            FontSize="12"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{x:Bind InitialsBrush}" />
                        <Image Source="{x:Bind FallbackIcon, Mode=OneWay}" Stretch="UniformToFill" />
                        <Image
                            Source="{x:Bind Icon}"
                            Stretch="UniformToFill"
                            ImageFailed="OnManifestIconFailed"
                            Visibility="{x:Bind ManifestIconVisibility, Mode=OneWay}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock
                            Text="{x:Bind DisplayName}"
                            MaxWidth="240"
                            FontSize="13.5"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <Button
                            Width="22"
                            Height="22"
                            MinHeight="0"
                            Padding="0"
                            Background="Transparent"
                            AutomationProperties.Name="Out of date for this client"
                            ToolTipService.ToolTip="{x:Bind OutOfDateTip, Mode=OneWay}"
                            Visibility="{x:Bind OutOfDateVisibility, Mode=OneWay}">
                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </Button>
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind FolderName}"
                        FontFamily="Cascadia Mono"
                        FontSize="11"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <ProgressBar
                        Height="3"
                        Maximum="1"
                        Margin="0,2,0,0"
                        Value="{x:Bind UpdateProgress, Mode=OneWay}"
                        Visibility="{x:Bind UpdatingVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind UpdatingLine, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind UpdatingVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="Type /reload in game to load the updated files"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Visibility="{x:Bind ReloadHintVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind StatusMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Visibility="{x:Bind FailedVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind UninstallError, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Visibility="{x:Bind UninstallErrorVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind StatusMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind NoticeVisibility, Mode=OneWay}" />
                </StackPanel>

                <ContentControl
                    Grid.Column="2"
                    IsTabStop="{x:Bind HasVersionTip, Mode=OneWay}"
                    UseSystemFocusVisuals="True"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind VersionTip, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind VersionTip, Mode=OneWay}">
                    <StackPanel Spacing="2">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="12"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="{x:Bind VersionPairVisibility, Mode=OneWay}">
                                <Run Text="{x:Bind NotInstalledRunText, Mode=OneWay}" /><Run Text="{x:Bind InstalledRunText, Mode=OneWay}" FontFamily="Cascadia Mono" FontSize="11.5" /><Run Text=" &#x2192; " /><Run Text="{x:Bind AvailableVersionShort, Mode=OneWay}" FontFamily="Cascadia Mono" FontSize="11.5" Foreground="{x:Bind NewVersionBrush, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                Text="{x:Bind InstalledVersionShort, Mode=OneWay}"
                                FontFamily="Cascadia Mono"
                                FontSize="11.5"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind CurrentVersionVisibility, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind AvailableVersionShort, Mode=OneWay}"
                                FontFamily="Cascadia Mono"
                                FontSize="11.5"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AvailableVersionBrush}"
                                Visibility="{x:Bind UpdatingVisibility, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                Width="22"
                                Height="22"
                                MinHeight="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                AutomationProperties.Name="Changelog"
                                ToolTipService.ToolTip="Changelog"
                                Click="OnChangelogClick"
                                Visibility="{x:Bind ChangelogVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </Grid>
                        <TextBlock
                            Text="{x:Bind ReleasedText, Mode=OneWay}"
                            FontSize="11.5"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ReleasedVisibility, Mode=OneWay}" />
                        <TextBlock
                            Text="No releases yet"
                            FontSize="12.5"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind NoReleasesVisibility, Mode=OneWay}" />
                    </StackPanel>
                </ContentControl>

                <Button
                    Grid.Column="3"
                    Height="24"
                    MinHeight="0"
                    Padding="8,0,6,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ChipBrush}"
                    Command="{x:Bind ChangeChannelCommand}"
                    AutomationProperties.Name="Release channel"
                    Visibility="{x:Bind ChannelChipVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind Channel, Mode=OneWay}" FontSize="12" />
                        <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Button>
                <ContentControl
                    Grid.Column="3"
                    IsTabStop="True"
                    UseSystemFocusVisuals="True"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="{x:Bind SingleChannelTip, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind SingleChannelTip, Mode=OneWay}"
                    Visibility="{x:Bind SingleChannelVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Channel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </ContentControl>
                <TextBlock
                    Grid.Column="3"
                    Text="-"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Visibility="{x:Bind NoChannelVisibility, Mode=OneWay}" />

                <TextBlock
                    Grid.Column="4"
                    Text="{x:Bind Source}"
                    FontSize="12.5"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Grid Grid.Column="5" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind StatusText, Mode=OneWay}"
                        FontSize="12.5"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"
                        Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                        Visibility="{x:Bind StatusTextVisibility, Mode=OneWay}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind UpToDateVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE73E;" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="Up to date" FontSize="12.5" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    </StackPanel>
                    <Border
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        Padding="8,2"
                        Background="{ThemeResource ChipBrush}"
                        Visibility="{x:Bind IgnoredPillVisibility, Mode=OneWay}">
                        <TextBlock Text="Ignored" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Border>
                    <Border
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        Padding="8,2"
                        Background="{ThemeResource ChipBrush}"
                        Visibility="{x:Bind HiddenPillVisibility, Mode=OneWay}">
                        <TextBlock Text="Hidden" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </Grid>

                <StackPanel
                    Grid.Column="6"
                    Orientation="Horizontal"
                    Spacing="6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <Button
                        Height="32"
                        Content="{x:Bind ActionLabel, Mode=OneWay}"
                        Style="{x:Bind ActionStyle, Mode=OneWay}"
                        Command="{x:Bind UpdateCommand}"
                        Visibility="{x:Bind ActionVisibility, Mode=OneWay}" />
                    <Button Height="32" Content="Retry" Command="{x:Bind UpdateCommand}" Visibility="{x:Bind FailedVisibility, Mode=OneWay}" />
                    <Button
                        Height="32"
                        Content="Sign in to RestedXP"
                        Command="{x:Bind RestedXpSignInCommand}"
                        Visibility="{x:Bind RestedXpSignInVisibility, Mode=OneWay}" />
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.Name="More options"
                        ToolTipService.ToolTip="More"
                        Flyout="{StaticResource RowMenu}"
                        Visibility="{x:Bind OverflowVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LocalRowTemplate" x:DataType="vm:LocalAddonRowViewModel">
            <Grid
                Padding="16,8"
                MinHeight="{StaticResource CardRowMinHeight}"
                ColumnSpacing="12"
                Background="Transparent"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource RowHairlineBrush}"
                SizeChanged="OnTableRowSizeChanged">
                <Grid.Resources>
                    <MenuFlyout x:Key="RowMenu" Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="{x:Bind HideLabel, Mode=OneWay}" Command="{x:Bind ToggleHiddenCommand}" />
                        <MenuFlyoutItem Text="Open folder" Command="{x:Bind OpenFolderCommand}" />
                        <MenuFlyoutSeparator Visibility="{x:Bind UninstallVisibility}" />
                        <MenuFlyoutItem
                            Text="Uninstall"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Command="{x:Bind UninstallCommand}"
                            Visibility="{x:Bind UninstallVisibility}">
                            <MenuFlyoutItem.Resources>
                                <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
                                <StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="SystemFillColorCriticalBrush" />
                            </MenuFlyoutItem.Resources>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.Resources>
                <Grid.ContextFlyout>
                    <StaticResource ResourceKey="RowMenu" />
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="3*" MinWidth="96" />
                    <ColumnDefinition Width="2*" MinWidth="114" />
                    <ColumnDefinition Width="1.2*" MinWidth="84" />
                    <ColumnDefinition Width="1*" MinWidth="60" />
                    <ColumnDefinition Width="1.5*" MinWidth="76" />
                    <ColumnDefinition Width="184" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="30"
                    Height="30"
                    VerticalAlignment="Center"
                    CornerRadius="6"
                    Background="{ThemeResource ChipBrush}">
                    <Grid>
                        <TextBlock
                            Text="{x:Bind Initials}"
                            FontSize="12"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{x:Bind InitialsBrush}" />
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock
                            Text="{x:Bind DisplayName}"
                            MaxWidth="240"
                            FontSize="13.5"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <Button
                            Width="22"
                            Height="22"
                            MinHeight="0"
                            Padding="0"
                            Background="Transparent"
                            AutomationProperties.Name="Out of date for this client"
                            ToolTipService.ToolTip="{x:Bind OutOfDateTip}"
                            Visibility="{x:Bind OutOfDateVisibility}">
                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </Button>
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind FolderLine}"
                        FontFamily="Cascadia Mono"
                        FontSize="11"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        Text="{x:Bind FailureMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Visibility="{x:Bind FailedVisibility, Mode=OneWay}" />
                </StackPanel>

                <ContentControl
                    Grid.Column="2"
                    IsTabStop="{x:Bind HasVersionTip, Mode=OneWay}"
                    UseSystemFocusVisuals="True"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="{x:Bind VersionTip, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind VersionTip, Mode=OneWay}">
                    <TextBlock
                        Text="{x:Bind Version}"
                        FontFamily="Cascadia Mono"
                        FontSize="11.5"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </ContentControl>

                <TextBlock
                    Grid.Column="3"
                    Text="-"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <TextBlock
                    Grid.Column="4"
                    Text="{x:Bind Source}"
                    FontSize="12.5"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <TextBlock
                    Grid.Column="5"
                    Text="-"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Visibility="{x:Bind StatusDashVisibility, Mode=OneWay}" />
                <Border
                    Grid.Column="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CornerRadius="4"
                    Padding="8,2"
                    Background="{ThemeResource ChipBrush}"
                    Visibility="{x:Bind HiddenPillVisibility, Mode=OneWay}">
                    <TextBlock Text="Hidden" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>

                <Button
                    Grid.Column="6"
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="More options"
                    ToolTipService.ToolTip="More"
                    Flyout="{StaticResource RowMenu}">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                </Button>
            </Grid>
        </DataTemplate>

        <views:AddonTableTemplateSelector
            x:Key="AddonTableTemplateSelector"
            Addon="{StaticResource AddonRowTemplate}"
            Local="{StaticResource LocalRowTemplate}" />
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowPage">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CheckedLabel.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WidePage">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="26,7,26,0" ColumnSpacing="6">
            <Grid.Resources>
                <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="Addons"
                FontSize="28"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />

            <Button
                x:Name="InstallPicker"
                Grid.Column="4"
                Height="32"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                MinWidth="200"
                Padding="11,0,10,2"
                HorizontalContentAlignment="Stretch"
                Background="{ThemeResource ChipBrush}"
                AutomationProperties.Name="Switch install"
                ToolTipService.ToolTip="{x:Bind ViewModel.SelectedInstall.FlavourPath, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.InstallPickerVisibility, Mode=OneWay}">
                <Button.Resources>
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="LayerFillColorAltBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ChipBrush" />
                </Button.Resources>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Glyph="&#xE7BA;"
                        FontSize="13"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Visibility="{x:Bind ViewModel.SelectedInstall.NoGameVersionVisibility, Mode=OneWay, FallbackValue=Collapsed}" />
                    <Image
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        Source="{x:Bind ViewModel.SelectedInstall.ProductIcon, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.SelectedInstall.ProductIconVisibility, Mode=OneWay, FallbackValue=Collapsed}" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.SelectedInstall.Label, Mode=OneWay}"
                        FontSize="14"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <FontIcon
                        Grid.Column="2"
                        Glyph="&#xE70D;"
                        FontSize="10"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Button.Flyout>
                    <!-- A windowed Flyout's open animation runs inside a backdrop window already shown at full size, which reads as an empty box then a slide. -->
                    <Flyout x:Name="InstallFlyout" Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="False" AreOpenCloseAnimationsEnabled="False">
                        <Flyout.SystemBackdrop>
                            <DesktopAcrylicBackdrop />
                        </Flyout.SystemBackdrop>
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding" Value="4" />
                                <Setter Property="Background" Value="{ThemeResource MenuFlyoutPresenterBackground}" />
                                <Setter Property="BorderBrush" Value="{ThemeResource MenuFlyoutPresenterBorderBrush}" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <StackPanel Width="300" Spacing="2">
                            <StackPanel.Resources>
                                <StaticResource x:Key="ButtonBackground" ResourceKey="MenuFlyoutItemBackground" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="MenuFlyoutItemBackgroundPointerOver" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="MenuFlyoutItemBackgroundPressed" />
                            </StackPanel.Resources>
                            <TextBlock
                                Text="Switch install"
                                FontSize="11.5"
                                Margin="8,4,8,2"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <ItemsControl
                                ItemsSource="{x:Bind ViewModel.Installs, Mode=OneWay}"
                                ItemTemplate="{StaticResource InstallOptionTemplate}" />
                            <Border Height="1" Margin="8,2" Background="{ThemeResource MenuFlyoutSeparatorBackground}" />
                            <Button
                                Height="36"
                                Padding="8,0"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Click="OnAddInstallClick">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Grid.Column="1" Text="Add install" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button
                                Height="36"
                                Padding="8,0"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Click="OnManageInstallsClick">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                                    <TextBlock Grid.Column="1" Text="Manage installs" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button
                Grid.Column="5"
                Width="32"
                Height="32"
                Padding="0"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.EditInstallCommand}"
                AutomationProperties.Name="Edit install"
                ToolTipService.ToolTip="Edit install"
                Visibility="{x:Bind ViewModel.InstallPickerVisibility, Mode=OneWay}">
                <FontIcon Glyph="&#xE70F;" FontSize="14" />
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind ViewModel.SelectedInstall.StatusText, Mode=OneWay}"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Visibility="{x:Bind ViewModel.SelectedInstall.StatusVisibility, Mode=OneWay, FallbackValue=Collapsed}" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="5"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.SelectedInstall.RunningDotVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                    <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Running" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                </StackPanel>
                <TextBlock
                    Text="Game version not set"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Visibility="{x:Bind ViewModel.SelectedInstall.NoGameVersionVisibility, Mode=OneWay, FallbackValue=Collapsed}" />
            </StackPanel>

            <TextBlock
                x:Name="CheckedLabel"
                Grid.Column="3"
                Text="{x:Bind ViewModel.CheckedText, Mode=OneWay}"
                FontSize="12"
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

            <Button
                Grid.Column="6"
                Width="32"
                Height="32"
                Padding="0"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.RefreshCommand}"
                AutomationProperties.Name="Refresh"
                ToolTipService.ToolTip="Check for updates">
                <FontIcon
                    Glyph="&#xE72C;"
                    FontSize="14"
                    views:Spinner.IsSpinning="{x:Bind ViewModel.RefreshCommand.IsRunning, Mode=OneWay}" />
            </Button>

            <Button
                Grid.Column="7"
                Width="32"
                Height="32"
                Padding="0"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.SelectedInstall.OpenFolderCommand, Mode=OneWay}"
                AutomationProperties.Name="Open AddOns folder"
                ToolTipService.ToolTip="Open AddOns folder"
                Visibility="{x:Bind ViewModel.InstallPickerVisibility, Mode=OneWay}">
                <FontIcon Glyph="&#xE838;" FontSize="14" />
            </Button>
        </Grid>

        <views:BannerList
            Grid.Row="1"
            Margin="26,10,26,0"
            Banners="{x:Bind ViewModel.Banners, Mode=OneWay}" />

        <ScrollViewer Grid.Row="2">
            <StackPanel Padding="26,10,26,26" Spacing="10">
                <Border
                    CornerRadius="8"
                    Padding="12,8"
                    Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
                    Visibility="{x:Bind ViewModel.AppUpdateVisibility, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.AppUpdateTitle, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <HyperlinkButton Content="View changelog" Padding="4,0" NavigateUri="{x:Bind ViewModel.AppUpdateChangelogUri, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Height="32"
                            Content="{x:Bind ViewModel.AppUpdateActionLabel, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.InstallAppUpdateCommand}" />
                    </Grid>
                </Border>

                <Border
                    CornerRadius="8"
                    Padding="12,8"
                    Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
                    Visibility="{x:Bind ViewModel.StoreListingVisibility, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE719;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Steward is on the Microsoft Store" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button
                            Grid.Column="2"
                            Height="32"
                            Content="Open the Store"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.OpenStoreListingCommand}" />
                    </Grid>
                </Border>

                <Border
                    CornerRadius="8"
                    Padding="12,8"
                    Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
                    Visibility="{x:Bind ViewModel.StoreSwitchVisibility, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE719;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Column="1" Text="The Microsoft Store version is installed" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button
                            Grid.Column="2"
                            Height="32"
                            Content="Switch"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SwitchToStoreCommand}" />
                    </Grid>
                </Border>

                <InfoBar
                    Severity="Error"
                    IsClosable="False"
                    CornerRadius="8"
                    IsOpen="{x:Bind ViewModel.StatusMessageIsOpen, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.StatusMessageIsOpen, Mode=OneWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Content="Retry" Command="{x:Bind ViewModel.RefreshCommand}" Visibility="{x:Bind ViewModel.RetryVisibility, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Grid ColumnSpacing="10" Visibility="{x:Bind ViewModel.TableVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="220" VerticalAlignment="Center">
                        <TextBox
                            Height="32"
                            Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Filter addons"
                            Padding="32,6,10,6"
                            AutomationProperties.Name="Filter addons" />
                        <FontIcon
                            Glyph="&#xE721;"
                            FontSize="13"
                            Margin="11,0,0,0"
                            HorizontalAlignment="Left"
                            IsHitTestVisible="False"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>

                    <controls:Segmented
                        Grid.Column="1"
                        SelectionMode="Single"
                        VerticalAlignment="Center"
                        SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}">
                        <controls:SegmentedItem Content="All" />
                        <controls:SegmentedItem Content="{x:Bind ViewModel.UpdatesSegmentLabel, Mode=OneWay}" />
                        <controls:SegmentedItem
                            Content="{x:Bind ViewModel.HiddenSegmentLabel, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HiddenSegmentVisibility, Mode=OneWay}" />
                    </controls:Segmented>

                    <Button
                        Grid.Column="2"
                        Height="32"
                        Content="Default order"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.DefaultOrderCommand}"
                        Visibility="{x:Bind ViewModel.DefaultOrderVisibility, Mode=OneWay}" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                        <Button
                            Height="32"
                            CornerRadius="4,0,0,4"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.Name="{x:Bind ViewModel.UpdateAllLabel, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.UpdateAllEnabled, Mode=OneWay}"
                            Click="OnUpdateAllClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.UpdateAllLabel, Mode=OneWay}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="UpdateAllMore"
                            Width="34"
                            Height="32"
                            Padding="0"
                            CornerRadius="0,4,4,0"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.Name="More update options"
                            IsEnabled="{x:Bind ViewModel.UpdateAllEnabled, Mode=OneWay}">
                            <FontIcon Glyph="&#xE70D;" FontSize="10" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem
                                        Text="{x:Bind ViewModel.UpdateAllOnInstallLabel, Mode=OneWay}"
                                        KeyboardAcceleratorTextOverride="{x:Bind ViewModel.SelectedUpdateCountText, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind ViewModel.UpdateAllOnInstallAccessibleName, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.UpdateAllCommand}" />
                                    <MenuFlyoutItem
                                        Text="Update all installs"
                                        KeyboardAcceleratorTextOverride="{x:Bind ViewModel.TotalUpdateCountText, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind ViewModel.UpdateAllInstallsAccessibleName, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.UpdateAllInstallsCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border
                    Margin="0,10,0,0"
                    CornerRadius="8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    Visibility="{x:Bind ViewModel.TableVisibility, Mode=OneWay}">
                    <StackPanel>
                        <Grid Padding="16,6" ColumnSpacing="12" SizeChanged="OnTableRowSizeChanged">
                            <Grid.Resources>
                                <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="3*" MinWidth="96" />
                                <ColumnDefinition Width="2*" MinWidth="114" />
                                <ColumnDefinition Width="1.2*" MinWidth="84" />
                                <ColumnDefinition Width="1*" MinWidth="60" />
                                <ColumnDefinition Width="1.5*" MinWidth="76" />
                                <ColumnDefinition Width="184" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="1"
                                Height="26"
                                MinHeight="0"
                                Padding="4,0"
                                Margin="-4,0,0,0"
                                Command="{x:Bind ViewModel.SortByCommand}"
                                CommandParameter="name">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Name" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <FontIcon Glyph="{x:Bind ViewModel.NameSortGlyph, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="2"
                                Height="26"
                                MinHeight="0"
                                Padding="4,0"
                                Margin="-4,0,0,0"
                                AutomationProperties.Name="Sort by last updated"
                                Command="{x:Bind ViewModel.SortByCommand}"
                                CommandParameter="version">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Version" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <FontIcon Glyph="{x:Bind ViewModel.VersionSortGlyph, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="3" Text="Channel" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button
                                Grid.Column="4"
                                Height="26"
                                MinHeight="0"
                                Padding="4,0"
                                Margin="-4,0,0,0"
                                Command="{x:Bind ViewModel.SortByCommand}"
                                CommandParameter="source">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Source" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <FontIcon Glyph="{x:Bind ViewModel.SourceSortGlyph, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="5"
                                Height="26"
                                MinHeight="0"
                                Padding="4,0"
                                Margin="-4,0,0,0"
                                Command="{x:Bind ViewModel.SortByCommand}"
                                CommandParameter="status">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Status" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <FontIcon Glyph="{x:Bind ViewModel.StatusSortGlyph, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ItemsRepeater
                            ItemsSource="{x:Bind ViewModel.TableRows}"
                            ItemTemplate="{StaticResource AddonTableTemplateSelector}" />

                        <TextBlock
                            Text="No addons match"
                            Padding="0,28"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.NoMatchVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="460"
            Spacing="12"
            Visibility="{x:Bind ViewModel.GameVersionPromptVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xE7BA;" FontSize="36" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            <TextBlock
                Text="Choose a game version for this install"
                FontSize="16"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                TextAlignment="Center" />
            <TextBlock
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Steward needs to know which game this folder runs so it installs the matching addon builds. Folders added by hand have no .flavor.info to read it from." />
            <Button
                Height="32"
                HorizontalAlignment="Center"
                Content="Choose game version"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.EditInstallCommand}" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="460"
            Spacing="12"
            Visibility="{x:Bind ViewModel.NoInstallsVisibility, Mode=OneWay}">
            <FontIcon
                Glyph="&#xE8B7;"
                FontSize="44"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                Text="No World of Warcraft installs found"
                FontSize="20"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                TextAlignment="Center" />
            <TextBlock
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Steward finds a World of Warcraft: Forever folder by its .flavor.info, such as _classic_beta_." />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button
                    Height="32"
                    Content="Add install"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.BrowseCommand}" />
                <Button Height="32" Content="Rescan" Command="{x:Bind ViewModel.RescanCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
