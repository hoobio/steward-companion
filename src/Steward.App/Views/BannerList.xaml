<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Steward.App.Views.BannerList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Steward.App.ViewModels">

    <UserControl.Resources>
        <DataTemplate x:Key="BannerActionTemplate" x:DataType="vm:BannerActionViewModel">
            <Button Height="28" Padding="10,0" Content="{x:Bind Label}" Command="{x:Bind Command}" />
        </DataTemplate>

        <DataTemplate x:Key="BannerTemplate" x:DataType="vm:BannerViewModel">
            <Border CornerRadius="8" Padding="12,8" Background="{x:Bind Background}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Glyph="{x:Bind IconGlyph}"
                        FontSize="16"
                        Foreground="{x:Bind IconForeground}" />

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Message}" Visibility="{x:Bind HasMessage}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ItemsControl Grid.Column="2" VerticalAlignment="Center" ItemsSource="{x:Bind Actions}" ItemTemplate="{StaticResource BannerActionTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Button
                        Grid.Column="3"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        Command="{x:Bind DismissCommand}"
                        Visibility="{x:Bind IsDismissible}"
                        AutomationProperties.Name="Dismiss">
                        <FontIcon Glyph="&#xE8BB;" FontSize="11" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ItemsControl x:Name="List" ItemTemplate="{StaticResource BannerTemplate}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>
