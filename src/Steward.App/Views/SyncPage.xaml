<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Steward.App.Views.SyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:Steward.App.Views"
    xmlns:vm="using:Steward.App.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="GuildOptionTemplate" x:DataType="vm:GuildOptionViewModel">
            <Button
                Height="40"
                Padding="8,0"
                BorderThickness="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Click="GuildOptionClick">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="24"
                        Height="24"
                        VerticalAlignment="Center"
                        CornerRadius="6"
                        Background="{ThemeResource ChipBrush}">
                        <Grid>
                            <TextBlock
                                Text="{x:Bind Initial}"
                                FontSize="11.5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Image Source="{x:Bind Icon}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Label}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind Role}"
                            FontSize="11.5"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <Ellipse
                        Grid.Column="2"
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{x:Bind CurrentDotVisibility, Mode=OneWay}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SyncDatasetTemplate" x:DataType="vm:SyncDatasetViewModel">
            <Grid
                BorderThickness="{x:Bind HairlineThickness}"
                BorderBrush="{ThemeResource RowHairlineBrush}"
                Padding="{StaticResource CardRowPadding}"
                MinHeight="{StaticResource CardRowMinHeight}"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="96" />
                    <ColumnDefinition Width="Auto" MinWidth="80" />
                    <ColumnDefinition Width="Auto" MinWidth="88" />
                    <ColumnDefinition Width="Auto" MinWidth="60" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="30"
                    Height="30"
                    VerticalAlignment="Center"
                    CornerRadius="6"
                    Background="{ThemeResource ChipBrush}">
                    <FontIcon
                        Glyph="{x:Bind Glyph}"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock
                        Text="{x:Bind SourceFile, Mode=OneWay}"
                        FontFamily="Cascadia Mono"
                        FontSize="11.5"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        Text="{x:Bind CharacterSync.LastPushText, Mode=OneWay, FallbackValue=''}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind CharacterSyncVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind CharacterSync.Error, Mode=OneWay, FallbackValue=''}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Visibility="{x:Bind CharacterSync.ErrorVisibility, Mode=OneWay, FallbackValue=Collapsed}" />
                    <TextBlock
                        Text="{x:Bind CharacterSync.RejectedSummary, Mode=OneWay, FallbackValue=''}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Visibility="{x:Bind CharacterSync.RejectedVisibility, Mode=OneWay, FallbackValue=Collapsed}" />
                    <TextBlock
                        Text="{x:Bind Note, Mode=OneWay}"
                        TextWrapping="Wrap"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="{x:Bind CharacterSync.AcceptedText, Mode=OneWay, FallbackValue=''}"
                    FontSize="12.5"
                    TextAlignment="Right"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind CharacterSync.AcceptedVisibility, Mode=OneWay, FallbackValue=Collapsed}" />

                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Text="{x:Bind RecordsText, Mode=OneWay}"
                    FontSize="12.5"
                    TextAlignment="Right"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind RecordsVisibility, Mode=OneWay}" />

                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Text="{x:Bind ExportedAtText, Mode=OneWay}"
                    FontSize="12"
                    TextAlignment="Right"
                    Foreground="{x:Bind ExportedAtBrush, Mode=OneWay}"
                    Visibility="{x:Bind ExportedAtVisibility, Mode=OneWay}" />

                <Border
                    Grid.Column="5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    CornerRadius="4"
                    Padding="8,2"
                    Background="{ThemeResource ChipBrush}"
                    Visibility="{x:Bind ComingSoonVisibility, Mode=OneWay}">
                    <TextBlock
                        Text="Soon"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SyncInstallCardTemplate" x:DataType="vm:SyncInstallViewModel">
            <Expander
                IsExpanded="True"
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="8"
                BorderThickness="0">
                <Expander.Resources>
                    <Thickness x:Key="ExpanderContentBorderThickness">0</Thickness>
                    <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
                    <Thickness x:Key="ExpanderContentUpBorderThickness">0</Thickness>
                    <Thickness x:Key="ExpanderHeaderPadding">16,0,0,0</Thickness>
                </Expander.Resources>
                <Expander.Header>
                    <Grid ColumnSpacing="12" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind DisplayName}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock
                                Text="{x:Bind FlavourPath}"
                                FontFamily="Cascadia Mono"
                                FontSize="11.5"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock
                                Text="{x:Bind ReadError, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Visibility="{x:Bind ReadErrorVisibility, Mode=OneWay}" />
                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            CornerRadius="4"
                            Padding="6,2"
                            Background="{ThemeResource ChipBrush}">
                            <TextBlock
                                Text="{x:Bind ClientVersion, Mode=OneWay}"
                                FontFamily="Cascadia Mono"
                                FontSize="11.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>

                        <Border
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            CornerRadius="4"
                            Padding="8,2"
                            Background="{ThemeResource CautionTintBrush}"
                            Visibility="{x:Bind RunningPillVisibility, Mode=OneWay}">
                            <TextBlock Text="Running" FontSize="12" />
                        </Border>
                    </Grid>
                </Expander.Header>
                <StackPanel>
                    <StackPanel Padding="16,8" Spacing="4" Visibility="{x:Bind OldFormatVisibility, Mode=OneWay}">
                        <TextBlock Text="Update the Steward addon" FontWeight="SemiBold" />
                        <TextBlock
                            Text="This install's Steward.lua is from an older addon version that does not export characters, professions or the recipe catalogue."
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ItemsControl
                        ItemsSource="{x:Bind Datasets}"
                        ItemTemplate="{StaticResource SyncDatasetTemplate}"
                        Visibility="{x:Bind DatasetsVisibility, Mode=OneWay}" />
                </StackPanel>
            </Expander>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PageGutter}" Spacing="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Sync" FontSize="26" FontWeight="SemiBold" Margin="{StaticResource PageTitleMargin}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.LastSyncedText, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Height="48"
                    Width="216"
                    Margin="0,0,12,0"
                    Padding="8,0"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.Main.GuildPickerVisibility, Mode=OneWay}">
                    <!-- The template's BrushTransition interpolates ARGB, so an opaque hover over a clear rest brush fades through white; the subtle fills share one RGB. -->
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                        <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    </Button.Resources>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="28"
                            Height="28"
                            VerticalAlignment="Center"
                            CornerRadius="7"
                            Background="{ThemeResource ChipBrush}">
                            <Grid>
                                <TextBlock
                                    Text="{x:Bind ViewModel.Main.SelectedGuild.Initial, Mode=OneWay}"
                                    FontSize="12.5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Image Source="{x:Bind ViewModel.Main.SelectedGuild.Icon, Mode=OneWay}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind ViewModel.Main.SelectedGuild.Label, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Main.GuildSubtitle, Mode=OneWay}"
                                FontSize="11.5"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <FontIcon
                            Grid.Column="2"
                            Glyph="&#xE70D;"
                            FontSize="10"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                    <Button.Flyout>
                        <Flyout x:Name="GuildFlyout" Placement="BottomEdgeAlignedLeft" ShouldConstrainToRootBounds="False">
                            <Flyout.SystemBackdrop>
                                <DesktopAcrylicBackdrop />
                            </Flyout.SystemBackdrop>
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="4" />
                                    <Setter Property="Background" Value="{ThemeResource MenuFlyoutPresenterBackground}" />
                                    <Setter Property="BorderBrush" Value="{ThemeResource MenuFlyoutPresenterBorderBrush}" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel Width="232" Spacing="2">
                                <StackPanel.Resources>
                                    <StaticResource x:Key="ButtonBackground" ResourceKey="MenuFlyoutItemBackground" />
                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="MenuFlyoutItemBackgroundPointerOver" />
                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="MenuFlyoutItemBackgroundPressed" />
                                </StackPanel.Resources>
                                <TextBlock
                                    Text="Switch server"
                                    FontSize="11.5"
                                    Margin="8,4,8,2"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <ItemsControl
                                    ItemsSource="{x:Bind ViewModel.Main.Guilds}"
                                    ItemTemplate="{StaticResource GuildOptionTemplate}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        AutomationProperties.Name="Refresh"
                        ToolTipService.ToolTip="Read the local files again">
                        <FontIcon
                            Glyph="&#xE72C;"
                            FontSize="14"
                            views:Spinner.IsSpinning="{x:Bind ViewModel.RefreshCommand.IsRunning, Mode=OneWay}" />
                    </Button>
                    <Button
                        Height="32"
                        Content="Sync now"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SyncNowCommand}"
                        Visibility="{x:Bind ViewModel.SyncNowVisibility, Mode=OneWay}"
                        ToolTipService.ToolTip="Push characters to the guild now" />
                </StackPanel>
            </Grid>

            <InfoBar
                Severity="Error"
                IsClosable="False"
                CornerRadius="8"
                IsOpen="{x:Bind ViewModel.UnreachableIsOpen, Mode=OneWay}"
                Message="Could not reach api.hoobi.io. Check your connection." />

            <StackPanel
                HorizontalAlignment="Center"
                MaxWidth="460"
                Spacing="12"
                Padding="0,24"
                Visibility="{x:Bind ViewModel.NoInstallVisibility, Mode=OneWay}">
                <FontIcon
                    Glyph="&#xE74C;"
                    FontSize="44"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock
                    Text="No World of Warcraft install found"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <TextBlock
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Steward could not find a World of Warcraft: Forever install on this machine." />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                MaxWidth="460"
                Spacing="12"
                Padding="0,24"
                Visibility="{x:Bind ViewModel.AddonMissingVisibility, Mode=OneWay}">
                <FontIcon
                    Glyph="&#xE7FC;"
                    FontSize="44"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock
                    Text="The Steward addon is not installed"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <TextBlock
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Sync reads roster, loot and attendance from the Steward addon's saved variables. The addon has no releases yet." />
                <HyperlinkButton
                    Content="Open guild panel"
                    HorizontalAlignment="Center"
                    NavigateUri="https://guild.hoobi.io" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                MaxWidth="460"
                Spacing="12"
                Padding="0,24"
                Visibility="{x:Bind ViewModel.NeverExportedVisibility, Mode=OneWay}">
                <FontIcon
                    Glyph="&#xE7C3;"
                    FontSize="44"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock
                    Text="Steward has not exported anything yet"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <TextBlock
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Log in to a character. The addon writes its data when you log out, exit, or type /reload." />
            </StackPanel>

            <Border
                CornerRadius="8"
                Padding="16"
                Background="{ThemeResource CautionTintBrush}"
                Visibility="{x:Bind ViewModel.ClientRunningBannerVisibility, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" VerticalAlignment="Center" FontSize="20" Glyph="&#xE7BA;" />

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="World of Warcraft is running" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ClientRunningDetail, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl
                ItemsSource="{x:Bind ViewModel.Installs}"
                Visibility="{x:Bind ViewModel.CardsVisibility, Mode=OneWay}"
                ItemTemplate="{StaticResource SyncInstallCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <controls:SettingsCard
                Padding="{StaticResource CardRowPadding}"
                Header="Guild data in game"
                Description="{x:Bind ViewModel.GeneratedFileDescription, Mode=OneWay}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </controls:SettingsCard.HeaderIcon>
                <Button
                    Height="32"
                    Content="Write again"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Available once the guild API ships" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
