<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Steward.App.Views.SyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Steward.App.Views"
    xmlns:vm="using:Steward.App.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="PullDatasetTemplate" x:DataType="vm:SyncDatasetViewModel">
            <Grid
                BorderThickness="{x:Bind HairlineThickness}"
                BorderBrush="{ThemeResource RowHairlineBrush}"
                Padding="{StaticResource CardRowPadding}"
                MinHeight="{StaticResource CardRowMinHeight}"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="30"
                    Height="30"
                    VerticalAlignment="Center"
                    CornerRadius="6"
                    Background="{ThemeResource ChipBrush}">
                    <Image Source="{x:Bind IconSource}" Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" FontSize="13.5" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            Glyph="&#xE73E;"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Visibility="{x:Bind SyncedGlyphVisibility, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind StatusText, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="{x:Bind RecordsText, Mode=OneWay}"
                    FontSize="12.5"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ProfessionsCharacterTemplate" x:DataType="vm:ProfessionsCharacterViewModel">
            <Grid
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource RowHairlineBrush}"
                Padding="{StaticResource CardRowPadding}"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{x:Bind Name}" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock
                        Text="{x:Bind LevelClassText}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="{x:Bind SkillsSummary}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind SkillsVisibility}" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="200">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Right"
                        Visibility="{x:Bind SyncedVisibility}">
                        <FontIcon
                            Glyph="&#xE73E;"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock
                            Text="Synced"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    </StackPanel>
                    <TextBlock
                        Text="Changed, sending shortly"
                        FontSize="12"
                        TextAlignment="Right"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind PendingVisibility}" />
                    <TextBlock
                        Text="{x:Bind ReasonText}"
                        FontSize="12"
                        TextAlignment="Right"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Visibility="{x:Bind RejectedVisibility}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PageGutter}" Spacing="10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Sync" FontSize="26" FontWeight="SemiBold" Margin="{StaticResource PageTitleMargin}" />
                    <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Bind ViewModel.SubtitleGuild, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" /><Run Text="{x:Bind ViewModel.SubtitleSynced, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        Text="WoW is running, /reload to load new data"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Visibility="{x:Bind ViewModel.SubtitleRunningVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Main.JourneyStatus, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.Main.JourneyStatusVisibility, Mode=OneWay}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        AutomationProperties.Name="Refresh"
                        ToolTipService.ToolTip="Read the local files again">
                        <FontIcon
                            Glyph="&#xE72C;"
                            FontSize="14"
                            views:Spinner.IsSpinning="{x:Bind ViewModel.RefreshCommand.IsRunning, Mode=OneWay}" />
                    </Button>
                    <Button
                        Height="32"
                        Content="Sync now"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SyncNowCommand}"
                        Visibility="{x:Bind ViewModel.SyncNowVisibility, Mode=OneWay}"
                        ToolTipService.ToolTip="Push characters to the guild now" />
                </StackPanel>
            </Grid>

            <views:BannerList Banners="{x:Bind ViewModel.Main.Banners, Mode=OneWay}" />

            <InfoBar
                Severity="Error"
                IsClosable="False"
                CornerRadius="8"
                IsOpen="{x:Bind ViewModel.UnreachableIsOpen, Mode=OneWay}"
                Message="Could not reach api.hoobi.io. Check your connection." />

            <StackPanel
                HorizontalAlignment="Center"
                MaxWidth="460"
                Spacing="12"
                Padding="0,24"
                Visibility="{x:Bind ViewModel.NoInstallVisibility, Mode=OneWay}">
                <FontIcon
                    Glyph="&#xE74C;"
                    FontSize="44"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock
                    Text="No World of Warcraft install found"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <TextBlock
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Steward could not find a World of Warcraft: Forever install on this machine." />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                MaxWidth="460"
                Spacing="12"
                Padding="0,24"
                Visibility="{x:Bind ViewModel.AddonMissingVisibility, Mode=OneWay}">
                <FontIcon
                    Glyph="&#xE7FC;"
                    FontSize="44"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock
                    Text="The Steward addon is not installed"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <TextBlock
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Sync reads roster, loot and attendance from the Steward addon's saved variables. The addon has no releases yet." />
                <HyperlinkButton
                    Content="Open guild panel"
                    HorizontalAlignment="Center"
                    NavigateUri="https://guild.hoobi.io" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                MaxWidth="460"
                Spacing="12"
                Padding="0,24"
                Visibility="{x:Bind ViewModel.NeverExportedVisibility, Mode=OneWay}">
                <FontIcon
                    Glyph="&#xE7C3;"
                    FontSize="44"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock
                    Text="Steward has not exported anything yet"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <TextBlock
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Log in to a character. The addon writes its data when you log out, exit, or type /reload." />
            </StackPanel>

            <Border
                CornerRadius="8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.CardVisibility, Mode=OneWay}">
                <StackPanel>
                    <StackPanel Visibility="{x:Bind ViewModel.CardsVisibility, Mode=OneWay}">
                        <StackPanel Padding="16,8" Spacing="4" Visibility="{x:Bind ViewModel.Current.OldFormatVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                            <TextBlock Text="Update the Steward addon" FontWeight="SemiBold" />
                            <TextBlock
                                Text="This install's Steward.lua is from an older addon version that does not export characters, professions or the recipe catalogue."
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock
                            Padding="{StaticResource CardRowPadding}"
                            Text="{x:Bind ViewModel.Current.ReadError, Mode=OneWay, FallbackValue=''}"
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Visibility="{x:Bind ViewModel.Current.ReadErrorVisibility, Mode=OneWay, FallbackValue=Collapsed}" />
                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.Current.PullDatasets, Mode=OneWay, FallbackValue={x:Null}}"
                            ItemTemplate="{StaticResource PullDatasetTemplate}"
                            Visibility="{x:Bind ViewModel.Current.DatasetsVisibility, Mode=OneWay, FallbackValue=Collapsed}" />
                        <Border
                            BorderBrush="{ThemeResource RowHairlineBrush}"
                            BorderThickness="{x:Bind ViewModel.Current.ProfessionsHairlineThickness, Mode=OneWay, FallbackValue=0}"
                            Visibility="{x:Bind ViewModel.Current.DatasetsVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                            <Expander
                                IsExpanded="{x:Bind ViewModel.Current.IsProfessionsExpanded, Mode=TwoWay, FallbackValue=False}"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                CornerRadius="0"
                                BorderThickness="0">
                                <Expander.Resources>
                                    <Thickness x:Key="ExpanderContentBorderThickness">0</Thickness>
                                    <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
                                    <Thickness x:Key="ExpanderContentUpBorderThickness">0</Thickness>
                                    <Thickness x:Key="ExpanderHeaderPadding">16,0,0,0</Thickness>
                                </Expander.Resources>
                                <Expander.Header>
                                    <Grid ColumnSpacing="12" MinHeight="{StaticResource CardRowMinHeight}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Width="30"
                                            Height="30"
                                            VerticalAlignment="Center"
                                            CornerRadius="6"
                                            Background="{ThemeResource ChipBrush}">
                                            <Image Source="{x:Bind ViewModel.Current.ProfessionsDataset.IconSource, Mode=OneWay, FallbackValue={x:Null}}" Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.Current.ProfessionsDataset.Name, Mode=OneWay, FallbackValue=''}" FontSize="13.5" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon
                                                    Glyph="&#xE73E;"
                                                    FontSize="12"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                    Visibility="{x:Bind ViewModel.Current.ProfessionsDataset.SyncedGlyphVisibility, Mode=OneWay, FallbackValue=Collapsed}" />
                                                <TextBlock
                                                    Text="{x:Bind ViewModel.Current.ProfessionsDataset.StatusText, Mode=OneWay, FallbackValue=''}"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock
                                                Text="{x:Bind ViewModel.Current.ProfessionsDataset.CharacterSync.Error, Mode=OneWay, FallbackValue=''}"
                                                TextWrapping="Wrap"
                                                FontSize="12"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Visibility="{x:Bind ViewModel.Current.ProfessionsDataset.CharacterSync.ErrorVisibility, Mode=OneWay, FallbackValue=Collapsed}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.Current.ProfessionsDataset.Note, Mode=OneWay, FallbackValue=''}"
                                                TextWrapping="Wrap"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Visibility="{x:Bind ViewModel.Current.ProfessionsDataset.NoteVisibility, Mode=OneWay, FallbackValue=Collapsed}" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind ViewModel.Current.ProfessionsDataset.RecordsText, Mode=OneWay, FallbackValue=''}"
                                            FontSize="12.5"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                    <ItemsControl
                                        ItemsSource="{x:Bind ViewModel.Current.ProfessionsCharacters, Mode=OneWay, FallbackValue={x:Null}}"
                                        ItemTemplate="{StaticResource ProfessionsCharacterTemplate}" />
                                    <TextBlock
                                        Text="No characters of yours on this install yet."
                                        Padding="16,8"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Visibility="{x:Bind ViewModel.Current.NoOwnCharactersVisibility, Mode=OneWay, FallbackValue=Collapsed}" />
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>

                    <Grid
                        BorderThickness="{x:Bind ViewModel.GeneratedFileHairline, Mode=OneWay}"
                        BorderBrush="{ThemeResource RowHairlineBrush}"
                        Padding="{StaticResource CardRowPadding}"
                        MinHeight="{StaticResource CardRowMinHeight}"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Glyph="&#xE8A5;"
                            FontSize="16"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Guild data in game" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock
                                FontSize="12"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.GeneratedFilePath, Mode=OneWay}">
                                <Run Text="StewardSync.lua" FontFamily="Cascadia Mono" FontSize="11.5" /><Run Text="{x:Bind ViewModel.GeneratedFileStatus, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                Text="{x:Bind ViewModel.GeneratedFileError, Mode=OneWay}"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Visibility="{x:Bind ViewModel.GeneratedFileErrorVisibility, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                IsActive="{x:Bind ViewModel.WriteAgainCommand.IsRunning, Mode=OneWay}" />
                            <Button
                                Height="32"
                                Content="Write again"
                                Command="{x:Bind ViewModel.WriteAgainCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
