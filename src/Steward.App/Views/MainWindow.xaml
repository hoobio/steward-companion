<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Steward.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="Steward"
            IsBackButtonVisible="{x:Bind ViewModel.IsOnSettings, Mode=OneWay}"
            BackRequested="OnBackRequested">
            <TitleBar.RightHeader>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.ShellChromeVisibility, Mode=OneWay}">
                    <DropDownButton Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PersonPicture
                                Width="24"
                                Height="24"
                                ProfilePicture="{x:Bind ViewModel.AvatarImage, Mode=OneWay}"
                                DisplayName="{x:Bind ViewModel.UserName, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.UserName, Mode=OneWay}" VerticalAlignment="Center" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout>
                                <StackPanel Width="260" Spacing="8">
                                    <PersonPicture
                                        Width="34"
                                        Height="34"
                                        HorizontalAlignment="Left"
                                        ProfilePicture="{x:Bind ViewModel.AvatarImage, Mode=OneWay}"
                                        DisplayName="{x:Bind ViewModel.UserName, Mode=OneWay}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.UserName, Mode=OneWay}"
                                        FontSize="14"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.UserHandle, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.UserHandleVisibility, Mode=OneWay}"
                                        FontFamily="Cascadia Mono"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border
                                        HorizontalAlignment="Left"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.RoleLabel, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                    <Border Height="1" Background="{ThemeResource RowHairlineBrush}" />
                                    <HyperlinkButton Content="Open guild panel" NavigateUri="https://guild.hoobi.io" />
                                    <Button
                                        Content="Sign out"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Command="{x:Bind ViewModel.SignOutCommand}" />
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button Click="OnSettingsClick" ToolTipService.ToolTip="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid Grid.Row="1" x:Name="GatePanel" Visibility="{x:Bind ViewModel.GateVisibility, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="460"
                Spacing="16">
                <Image Source="ms-appx:///Assets/Steward.ico" Width="56" Height="56" />
                <TextBlock
                    Text="{x:Bind ViewModel.GateHeading, Mode=OneWay}"
                    FontSize="28"
                    FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Text="Steward keeps your guild's addons current and signs you in with the same Discord account the guild panel uses." />
                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Warning"
                    Visibility="{x:Bind ViewModel.TimeoutVisibility, Mode=OneWay}"
                    Message="Steward did not hear back from your browser. Sign in again." />
                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Warning"
                    Visibility="{x:Bind ViewModel.SessionExpiredVisibility, Mode=OneWay}"
                    Message="Your session expired. Sessions last 90 days from last use. Sign in again to carry on." />
                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Error"
                    Visibility="{x:Bind ViewModel.UnreachableVisibility, Mode=OneWay}"
                    Message="Could not reach api.hoobi.io. Check your connection. Steward will not have current addon versions until it can.">
                    <InfoBar.ActionButton>
                        <Button Content="Retry" Command="{x:Bind ViewModel.SignInCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Height="38"
                        Background="{ThemeResource DiscordBrush}"
                        Foreground="White"
                        Command="{x:Bind ViewModel.SignInCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{x:Bind ViewModel.IsSigningIn, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.CancelSignInVisibility, Mode=OneWay}" />
                            <TextBlock Text="Sign in with Discord" />
                        </StackPanel>
                    </Button>
                    <Button
                        Content="Cancel"
                        Command="{x:Bind ViewModel.CancelSignInCommand}"
                        Visibility="{x:Bind ViewModel.CancelSignInVisibility, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Opens your browser. Steward stores the session locally and never sees your password." />
            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Margin="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom">
                <TextBlock
                    Text="{x:Bind ViewModel.VersionLabel}"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <HyperlinkButton Content="Help" NavigateUri="https://github.com/hoobio/steward-companion" />
            </StackPanel>
        </Grid>

        <Frame
            x:Name="RootFrame"
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.ShellChromeVisibility, Mode=OneWay}" />
    </Grid>
</Window>
