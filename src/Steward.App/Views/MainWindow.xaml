<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Steward.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <Grid Background="{ThemeResource WindowGroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            Width="0"
            Height="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            ToolTipText="Steward"
            ContextMenuMode="SecondWindow"
            LeftClickCommand="{x:Bind ShowWindowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open Steward" Click="OnTrayOpenClick" />
                    <MenuFlyoutItem Text="Check for updates" Click="OnTrayRefreshClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Quit" Click="OnTrayQuitClick" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Canvas.ZIndex="1"
            Height="48"
            Title="Steward"
            IsBackButtonVisible="{x:Bind ViewModel.IsOnSettings, Mode=OneWay}"
            BackRequested="OnBackRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Steward-256.png" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.ShellChromeVisibility, Mode=OneWay}">
                    <DropDownButton
                        Height="36"
                        VerticalAlignment="Center"
                        Padding="8,4"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PersonPicture
                                Width="24"
                                Height="24"
                                ProfilePicture="{x:Bind ViewModel.AvatarImage, Mode=OneWay}"
                                DisplayName="{x:Bind ViewModel.UserName, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.UserName, Mode=OneWay}" VerticalAlignment="Center" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout x:Name="AccountFlyout">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel Width="280">
                                    <Grid Padding="16,16,16,12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <PersonPicture
                                            Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            VerticalAlignment="Center"
                                            ProfilePicture="{x:Bind ViewModel.AvatarImage, Mode=OneWay}"
                                            DisplayName="{x:Bind ViewModel.UserName, Mode=OneWay}" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind ViewModel.UserName, Mode=OneWay}"
                                                FontSize="14"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.UserHandle, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.UserHandleVisibility, Mode=OneWay}"
                                                FontFamily="Cascadia Mono"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Border
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                            <TextBlock
                                                Text="{x:Bind ViewModel.RoleLabel, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                    </Grid>
                                    <Border
                                        Height="1"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource RowHairlineBrush}" />
                                    <Button
                                        Content="Open guild panel"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="16,10"
                                        CornerRadius="0"
                                        Click="OnGuildPanelClick" />
                                    <Button
                                        Content="Sign out"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="16,10"
                                        CornerRadius="0"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Click="OnSignOutClick" />
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="OnSettingsClick"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid Grid.Row="0" Grid.RowSpan="2" x:Name="GatePanel" Visibility="{x:Bind ViewModel.GateVisibility, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="460"
                Spacing="16">
                <Image Source="ms-appx:///Assets/Steward-256.png" Width="56" Height="56" HorizontalAlignment="Center" />
                <TextBlock
                    Text="{x:Bind ViewModel.GateHeading, Mode=OneWay}"
                    FontSize="28"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Warning"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.TimeoutVisibility, Mode=OneWay}"
                    Message="Steward did not hear back from your browser. Sign in again." />
                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Warning"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.SessionExpiredVisibility, Mode=OneWay}"
                    Message="Your session expired. Sessions last 90 days from last use. Sign in again to carry on." />
                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Error"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.UnreachableVisibility, Mode=OneWay}"
                    Message="Could not reach api.hoobi.io. Check your connection. Steward will not have current addon versions until it can.">
                    <InfoBar.ActionButton>
                        <Button Content="Retry" Command="{x:Bind ViewModel.SignInCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button
                        Height="38"
                        Background="{ThemeResource DiscordBrush}"
                        Foreground="White"
                        Command="{x:Bind ViewModel.SignInCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{x:Bind ViewModel.IsSigningIn, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.CancelSignInVisibility, Mode=OneWay}" />
                            <TextBlock Text="Sign in with Discord" />
                        </StackPanel>
                    </Button>
                    <Button
                        Content="Cancel"
                        Command="{x:Bind ViewModel.CancelSignInCommand}"
                        Visibility="{x:Bind ViewModel.CancelSignInVisibility, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    FontSize="12"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Opens your browser. Steward stores the session locally and never sees your password." />
            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                Spacing="12"
                Margin="20,0,0,20"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom">
                <TextBlock
                    Text="{x:Bind ViewModel.VersionLabel}"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <HyperlinkButton
                    Content="Help"
                    Padding="0"
                    VerticalAlignment="Center"
                    NavigateUri="https://github.com/hoobio/steward-companion" />
            </StackPanel>
        </Grid>

        <Frame
            x:Name="RootFrame"
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.ShellChromeVisibility, Mode=OneWay}" />
    </Grid>
</Window>
