<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Steward.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Steward.App.Services"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:vm="using:Steward.App.ViewModels">

    <Grid Background="{ThemeResource WindowGroundBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="InstallOptionTemplate" x:DataType="vm:WowInstallViewModel">
                <Grid>
                    <Button
                        MinHeight="40"
                        Padding="8,5"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        ToolTipService.ToolTip="{x:Bind FlavourPath}"
                        Tag="{x:Bind}"
                        Click="OnInstallOptionClick">
                        <Grid ColumnSpacing="12" Opacity="{x:Bind RowOpacity}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="32" Height="32" VerticalAlignment="Center">
                                <FontIcon
                                    Glyph="&#xE7BA;"
                                    FontSize="14"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Visibility="{x:Bind NoGameVersionVisibility}" />
                                <Image Source="{x:Bind ProductIcon}" Stretch="Uniform" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind Label, Mode=OneWay}" /><Run Text="{x:Bind RunningText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </TextBlock>
                                <TextBlock
                                    FontSize="11.5"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Visibility="{x:Bind StatusVisibility}">
                                    <Run Text="{x:Bind StatusText, Mode=OneWay}" /><Run Text="{x:Bind SelectedDetailText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Text="Game version not set"
                                    FontSize="11.5"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Visibility="{x:Bind NoGameVersionVisibility}" />
                                <TextBlock
                                    Text="Folder not found"
                                    FontSize="11.5"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Visibility="{x:Bind MissingVisibility}" />
                            </StackPanel>

                            <Ellipse
                                Grid.Column="2"
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorCautionBrush}"
                                ToolTipService.ToolTip="World of Warcraft is running"
                                Visibility="{x:Bind RunningDotVisibility, Mode=OneWay}" />
                        </Grid>
                    </Button>
                    <Border
                        Width="3"
                        Height="16"
                        CornerRadius="1.5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{x:Bind SelectionIndicatorVisibility, Mode=OneWay}" />
                    <Button
                        Width="28"
                        Height="28"
                        Margin="0,0,4,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        AutomationProperties.Name="{x:Bind EditAccessibleName, Mode=OneWay}"
                        ToolTipService.ToolTip="Edit install"
                        Tag="{x:Bind}"
                        Click="OnEditInstallOptionClick">
                        <Button.Resources>
                            <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                        </Button.Resources>
                        <FontIcon Glyph="&#xE70F;" FontSize="13" />
                    </Button>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="GuildOptionTemplate" x:DataType="vm:GuildOptionViewModel">
                <Button
                    MinHeight="40"
                    Padding="8,5"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind Label}"
                    Tag="{x:Bind}"
                    Click="OnGuildOptionClick">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="24"
                            Height="24"
                            VerticalAlignment="Center"
                            CornerRadius="6"
                            Background="{ThemeResource ChipBrush}">
                            <Grid>
                                <TextBlock
                                    Text="{x:Bind Initial}"
                                    FontSize="11.5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Image Source="{x:Bind Icon}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Label}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Detail}"
                                FontSize="11.5"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <FontIcon
                            Grid.Column="2"
                            Glyph="&#xE73E;"
                            FontSize="13"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Visibility="{x:Bind CurrentVisibility, Mode=OneWay}" />
                    </Grid>
                </Button>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle Fill="{ThemeResource GroundGlowTopLeft}" />
            <Rectangle Fill="{ThemeResource GroundGlowTopRight}" />
        </Grid>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            Width="0"
            Height="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            ContextMenuMode="SecondWindow"
            NoLeftClickDelay="True">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open Steward" Click="OnTrayOpenClick" />
                    <MenuFlyoutItem Text="Check for updates" Click="OnTrayRefreshClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Quit" Click="OnTrayQuitClick" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Canvas.ZIndex="1"
            Height="48">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarMinDragRegionWidth">4</x:Double>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Steward-256.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <Grid
                    x:Name="InstallPickerHost"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.ShellChromeVisibility, Mode=OneWay}">
                    <Button
                        x:Name="InstallPicker"
                        Height="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        MinWidth="200"
                        Padding="11,0,10,2"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource ChipBrush}"
                        AutomationProperties.Name="Switch install"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SelectedInstall.FlavourPath, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.TitleBarPickerVisibility, Mode=OneWay}">
                        <Button.RenderTransform>
                            <TranslateTransform x:Name="InstallPickerOffset" />
                        </Button.RenderTransform>
                        <Button.Resources>
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="LayerFillColorAltBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ChipBrush" />
                        </Button.Resources>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="&#xE7BA;"
                                FontSize="13"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Visibility="{x:Bind ViewModel.SelectedInstall.NoGameVersionVisibility, Mode=OneWay, FallbackValue=Collapsed}" />
                            <Image
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                Source="{x:Bind ViewModel.SelectedInstall.ProductIcon, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.SelectedInstall.ProductIconVisibility, Mode=OneWay, FallbackValue=Collapsed}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.SelectedInstall.Label, Mode=OneWay}"
                                FontSize="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse
                                    x:Name="InstallPickerRunningDot"
                                    Width="7"
                                    Height="7"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource SystemFillColorCautionBrush}"
                                    ToolTipService.ToolTip="World of Warcraft is running"
                                    Visibility="{x:Bind ViewModel.SelectedInstall.RunningDotVisibility, Mode=OneWay, FallbackValue=Collapsed}" />
                                <FontIcon
                                    Glyph="&#xE70D;"
                                    FontSize="10"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <FlyoutBase.AttachedFlyout>
                            <!-- A windowed Flyout's open animation runs inside a backdrop window already shown at full size, which reads as an empty box then a slide. -->
                            <Flyout
                                x:Name="InstallFlyout"
                                Opening="OnInstallFlyoutOpening"
                                Closed="OnInstallFlyoutClosed"
                                Placement="Bottom"
                                ShouldConstrainToRootBounds="False"
                                AreOpenCloseAnimationsEnabled="False"
                                FlyoutPresenterStyle="{StaticResource TintedFlyoutPresenterStyle}">
                                <Flyout.SystemBackdrop>
                                    <services:TintedAcrylicBackdrop />
                                </Flyout.SystemBackdrop>
                                <StackPanel Width="260" Spacing="2">
                                    <StackPanel.Resources>
                                        <StaticResource x:Key="ButtonBackground" ResourceKey="MenuFlyoutItemBackground" />
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="MenuFlyoutItemBackgroundPointerOver" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="MenuFlyoutItemBackgroundPressed" />
                                    </StackPanel.Resources>
                                    <TextBlock
                                        Text="Switch install"
                                        FontSize="11.5"
                                        Margin="8,4,8,2"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <ItemsControl
                                        ItemsSource="{x:Bind ViewModel.Installs, Mode=OneWay}"
                                        ItemTemplate="{StaticResource InstallOptionTemplate}" />
                                    <Border Height="1" Margin="-4,2" Background="{ThemeResource MenuFlyoutSeparatorBackground}" />
                                    <Button
                                        Height="36"
                                        Padding="8,0"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Click="OnOpenAddOnsFolderClick">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE838;" FontSize="14" />
                                            <TextBlock Grid.Column="1" Text="Open AddOns folder" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button
                                        Height="36"
                                        Padding="8,0"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Click="OnAddInstallClick">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                                            <TextBlock Grid.Column="1" Text="Add install" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button
                                        Height="36"
                                        Padding="8,0"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Click="OnManageInstallsClick">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                                            <TextBlock Grid.Column="1" Text="Manage installs" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </Button>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <Grid Grid.Row="0" Grid.RowSpan="2" x:Name="GatePanel" Visibility="{x:Bind ViewModel.GateVisibility, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="460"
                Spacing="16">
                <Image Source="ms-appx:///Assets/Steward-256.png" Width="56" Height="56" HorizontalAlignment="Center" />
                <TextBlock
                    Text="{x:Bind ViewModel.GateHeading, Mode=OneWay}"
                    FontSize="28"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Warning"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.TimeoutVisibility, Mode=OneWay}"
                    Message="No sign-in reached Steward from the browser. Sign in again." />
                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Warning"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.SessionExpiredVisibility, Mode=OneWay}"
                    Message="Your session expired. Sign in again." />
                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Error"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.NotAuthorizedVisibility, Mode=OneWay}"
                    Message="This Discord user has no Steward access. Reach out to an Officer or to Hoobi." />
                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Error"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.SignInFailedVisibility, Mode=OneWay}"
                    Message="{x:Bind ViewModel.SignInError, Mode=OneWay}" />
                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Error"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.UnreachableVisibility, Mode=OneWay}"
                    Message="Could not reach api.hoobi.io. Check your connection.">
                    <InfoBar.ActionButton>
                        <Button Content="Retry" Command="{x:Bind ViewModel.SignInCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Error"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.ClientOutdatedVisibility, Mode=OneWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Content="Update Steward" Command="{x:Bind ViewModel.StatusActionCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button
                        Height="38"
                        Background="{ThemeResource DiscordBrush}"
                        Foreground="White"
                        Command="{x:Bind ViewModel.SignInCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{x:Bind ViewModel.IsSigningIn, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.CancelSignInVisibility, Mode=OneWay}" />
                            <TextBlock Text="Sign in with Discord" />
                        </StackPanel>
                    </Button>
                    <Button
                        Content="Cancel"
                        Command="{x:Bind ViewModel.CancelSignInCommand}"
                        Visibility="{x:Bind ViewModel.CancelSignInVisibility, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Spacing="8"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.PendingSignInVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <TextBlock
                            Text="If your browser didn't open,"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton
                            Content="click this link"
                            Padding="0"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.OpenBrowserAgainCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch">
                        <TextBox
                            x:Name="SignInUrlBox"
                            Text="{x:Bind ViewModel.PendingSignInUrl, Mode=OneWay}"
                            IsReadOnly="True"
                            FontFamily="Consolas"
                            FontSize="12"
                            BorderThickness="0"
                            CornerRadius="4"
                            MinHeight="0"
                            Padding="10,8"
                            VerticalAlignment="Center"
                            GotFocus="SelectAllSignInUrl"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            HorizontalAlignment="Stretch" />
                        <Button Content="Copy link" Command="{x:Bind ViewModel.CopyLinkCommand}" />
                    </StackPanel>
                    <InfoBar
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        CornerRadius="8"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.BrowserOpenFailedVisibility, Mode=OneWay}"
                        Message="Your browser did not open. Use Copy link and paste it into your browser." />
                    <TextBlock
                        Text="{x:Bind ViewModel.CopyLinkStatus, Mode=OneWay}"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <TextBlock
                    FontSize="12"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Opens your browser. Steward stores the session on this machine and never sees your password." />
            </StackPanel>

            <Grid Margin="20,0,20,20" VerticalAlignment="Bottom">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind ViewModel.VersionLabel}"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <HyperlinkButton
                        Content="Help"
                        Padding="0"
                        VerticalAlignment="Center"
                        NavigateUri="https://github.com/hoobio/steward-companion" />
                </StackPanel>
                <HyperlinkButton
                    Content="Check for updates"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.CheckForUpdatesVisibility, Mode=OneWay}"
                    Command="{x:Bind ViewModel.CheckForUpdatesCommand}" />
            </Grid>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="LeftCompact"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            OpenPaneLength="200"
            Background="Transparent"
            SelectionChanged="OnNavSelectionChanged"
            Visibility="{x:Bind ViewModel.ShellChromeVisibility, Mode=OneWay}">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="AddonsItem" Content="Addons" Tag="addons">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="SyncItem"
                    Content="Sync"
                    Tag="sync"
                    IsEnabled="{x:Bind ViewModel.IsApiReachable, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.SyncVisibility, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Visibility="{x:Bind ViewModel.SyncBadgeVisibility, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="GuidesItem"
                    Content="Guides"
                    Tag="guides"
                    Visibility="{x:Bind ViewModel.GuidesVisibility, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <Button
                    x:Name="AccountButton"
                    Height="36"
                    Margin="4,2,4,-2"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    BorderThickness="0"
                    CornerRadius="4"
                    ToolTipService.ToolTip="{x:Bind ViewModel.AccountAutomationName, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.AccountAutomationName, Mode=OneWay}">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackground" ResourceKey="NavigationViewItemBackground" />
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="NavigationViewItemBackgroundPointerOver" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="NavigationViewItemBackgroundPressed" />
                    </Button.Resources>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <PersonPicture
                                Width="24"
                                Height="24"
                                ProfilePicture="{x:Bind ViewModel.AvatarImage, Mode=OneWay}"
                                DisplayName="{x:Bind ViewModel.UserName, Mode=OneWay}" />
                            <Ellipse
                                Width="30"
                                Height="30"
                                Margin="-3"
                                StrokeThickness="2"
                                Stroke="{ThemeResource SystemFillColorSuccessBrush}"
                                Visibility="{x:Bind ViewModel.LiveUpdatesLiveVisibility, Mode=OneWay}" />
                            <Ellipse
                                Width="30"
                                Height="30"
                                Margin="-3"
                                StrokeThickness="2"
                                Stroke="{ThemeResource SystemFillColorCautionBrush}"
                                Visibility="{x:Bind ViewModel.LiveUpdatesReconnectingVisibility, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            Grid.Column="1"
                            Margin="4,0,8,0"
                            Text="{x:Bind ViewModel.UserName, Mode=OneWay}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <FlyoutBase.AttachedFlyout>
                        <!-- A windowed Flyout's open animation runs inside a backdrop window already shown at full size, which reads as an empty box then a slide. -->
                        <Flyout x:Name="AccountFlyout" Placement="RightEdgeAlignedBottom" ShouldConstrainToRootBounds="False" AreOpenCloseAnimationsEnabled="False">
                            <Flyout.SystemBackdrop>
                                <services:TintedAcrylicBackdrop />
                            </Flyout.SystemBackdrop>
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource TintedFlyoutPresenterStyle}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel Width="280">
                                <StackPanel.Resources>
                                    <StaticResource x:Key="ButtonBackground" ResourceKey="MenuFlyoutItemBackground" />
                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="MenuFlyoutItemBackgroundPointerOver" />
                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="MenuFlyoutItemBackgroundPressed" />
                                </StackPanel.Resources>
                                <Grid x:Name="AccountHeader" Padding="16,16,16,12" ColumnSpacing="12" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <PersonPicture
                                        Grid.Column="0"
                                        Width="40"
                                        Height="40"
                                        VerticalAlignment="Center"
                                        ProfilePicture="{x:Bind ViewModel.AvatarImage, Mode=OneWay}"
                                        DisplayName="{x:Bind ViewModel.UserName, Mode=OneWay}" />
                                    <StackPanel x:Name="AccountNameColumn" Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="AccountName"
                                            HorizontalAlignment="Left"
                                            Text="{x:Bind ViewModel.UserName, Mode=OneWay}"
                                            FontSize="14"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.UserHandle, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.UserHandleVisibility, Mode=OneWay}"
                                            FontFamily="Cascadia Mono"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Border
                                        x:Name="RolePill"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.RoleLabel, Mode=OneWay}"
                                            Foreground="{ThemeResource AccentButtonForeground}"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                </Grid>
                                <Border
                                    Height="1"
                                    HorizontalAlignment="Stretch"
                                    Background="{ThemeResource RowHairlineBrush}" />
                                <Button
                                    x:Name="GuildRow"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    BorderThickness="0"
                                    Margin="4,4,4,4"
                                    Padding="12,6"
                                    IsHitTestVisible="{x:Bind ViewModel.HasGuildChoice, Mode=OneWay}"
                                    IsTabStop="{x:Bind ViewModel.HasGuildChoice, Mode=OneWay}"
                                    AutomationProperties.Name="Guild"
                                    Visibility="{x:Bind ViewModel.GuildPickerVisibility, Mode=OneWay}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="24"
                                            Height="24"
                                            VerticalAlignment="Center"
                                            CornerRadius="6"
                                            Background="{ThemeResource ChipBrush}">
                                            <Grid>
                                                <TextBlock
                                                    Text="{x:Bind ViewModel.SelectedGuild.Initial, Mode=OneWay}"
                                                    FontSize="11.5"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <Image Source="{x:Bind ViewModel.SelectedGuild.Icon, Mode=OneWay}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedGuild.Label, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="Guild"
                                                FontSize="11.5"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <FontIcon
                                            Grid.Column="2"
                                            Glyph="&#xE76C;"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Visibility="{x:Bind ViewModel.GuildChevronVisibility, Mode=OneWay}" />
                                    </Grid>
                                    <FlyoutBase.AttachedFlyout>
                                        <Flyout
                                            x:Name="GuildFlyout"
                                            Placement="RightEdgeAlignedTop"
                                            ShouldConstrainToRootBounds="False"
                                            AreOpenCloseAnimationsEnabled="False"
                                            FlyoutPresenterStyle="{StaticResource TintedFlyoutPresenterStyle}">
                                            <Flyout.SystemBackdrop>
                                                <services:TintedAcrylicBackdrop />
                                            </Flyout.SystemBackdrop>
                                            <StackPanel x:Name="GuildFlyoutContent" Width="260" Spacing="2">
                                                <StackPanel.Resources>
                                                    <StaticResource x:Key="ButtonBackground" ResourceKey="MenuFlyoutItemBackground" />
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="MenuFlyoutItemBackgroundPointerOver" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="MenuFlyoutItemBackgroundPressed" />
                                                </StackPanel.Resources>
                                                <ItemsControl
                                                    ItemsSource="{x:Bind ViewModel.Guilds}"
                                                    ItemTemplate="{StaticResource GuildOptionTemplate}" />
                                            </StackPanel>
                                        </Flyout>
                                    </FlyoutBase.AttachedFlyout>
                                </Button>
                                <Border
                                    Height="1"
                                    HorizontalAlignment="Stretch"
                                    Background="{ThemeResource RowHairlineBrush}"
                                    Visibility="{x:Bind ViewModel.GuildPickerVisibility, Mode=OneWay}" />
                                <Button
                                    x:Name="OpenGuildPanelButton"
                                    Content="Open guild panel"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    BorderThickness="0"
                                    Margin="4,4,4,2"
                                    Padding="12,9,12,10"
                                    Click="OnGuildPanelClick" />
                                <Button
                                    x:Name="AccountSignOutButton"
                                    Content="Sign out"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    BorderThickness="0"
                                    Margin="4,2,4,4"
                                    Padding="12,9,12,10"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Click="OnSignOutClick" />
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </Button>
            </NavigationView.PaneFooter>
            <Frame x:Name="RootFrame" />
        </NavigationView>
    </Grid>
</Window>
