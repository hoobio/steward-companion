<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Steward.App.Views.GetAddonsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Steward.App.ViewModels"
    Title="Get addons"
    CloseButtonText="Done"
    DefaultButton="Close"
    CornerRadius="8">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">620</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">660</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="12">
        <TextBlock
            Text="{x:Bind ViewModel.Lede}"
            FontSize="13"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                PlaceholderText="Search by name or author"
                QueryIcon="Find"
                AutomationProperties.Name="Search addons"
                Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                Grid.Column="1"
                MinWidth="150"
                SelectedIndex="0"
                AutomationProperties.Name="Source">
                <x:String>All sources</x:String>
                <x:String>CurseForge</x:String>
            </ComboBox>
        </Grid>

        <TextBlock
            Text="CurseForge search is not enabled for Steward yet. Showing popular addons."
            FontSize="12"
            TextWrapping="Wrap"
            Foreground="{ThemeResource SystemFillColorCautionBrush}"
            Visibility="{x:Bind ViewModel.SearchUnavailableVisibility, Mode=OneWay}" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="{x:Bind ViewModel.Heading, Mode=OneWay}"
                FontSize="12"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <ProgressRing
                Grid.Column="1"
                Width="14"
                Height="14"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />
        </Grid>

        <TextBlock
            Text="{x:Bind ViewModel.Error, Mode=OneWay}"
            FontSize="12"
            TextWrapping="Wrap"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}" />

        <Border CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <TextBlock
                    Text="{x:Bind ViewModel.NoResultsText}"
                    Margin="12,28"
                    FontSize="13"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    HorizontalTextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Visibility="{x:Bind ViewModel.NoResultsVisibility, Mode=OneWay}" />
                <ScrollViewer Height="330">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Results}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:CurseForgeResultViewModel">
                                <Grid
                                    Padding="12,10"
                                    ColumnSpacing="12"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{ThemeResource RowHairlineBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="30"
                                        Height="30"
                                        VerticalAlignment="Center"
                                        CornerRadius="6"
                                        Background="{ThemeResource ChipBrush}">
                                        <Grid>
                                            <TextBlock
                                                Text="{x:Bind Initials}"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{x:Bind InitialsBrush}" />
                                            <Image Source="{x:Bind Icon}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                            <Run Text="{x:Bind Name}" FontSize="13.5" /><Run Text="{x:Bind ByAuthor}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </TextBlock>
                                        <TextBlock
                                            Text="{x:Bind Summary}"
                                            FontSize="12.5"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            ToolTipService.ToolTip="{x:Bind Summary}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                            <Run Text="CurseForge · " /><Run Text="{x:Bind LatestVersion}" FontFamily="Cascadia Mono" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock
                                            Text="{x:Bind Failure, Mode=OneWay}"
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Visibility="{x:Bind FailureVisibility, Mode=OneWay}" />
                                    </StackPanel>

                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Button
                                            Height="32"
                                            Content="Install"
                                            Command="{x:Bind InstallCommand}"
                                            AutomationProperties.Name="{x:Bind InstallAccessibleName}"
                                            Visibility="{x:Bind InstallVisibility, Mode=OneWay}" />
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind InstallingVisibility, Mode=OneWay}">
                                            <ProgressRing Width="14" Height="14" IsActive="{x:Bind IsInstalling, Mode=OneWay}" />
                                            <TextBlock Text="Installing" FontSize="12.5" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind InstalledVisibility, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE73E;" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <TextBlock Text="Installed" FontSize="12.5" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        </StackPanel>
                                        <HyperlinkButton
                                            Content="Available on CurseForge"
                                            FontSize="12.5"
                                            NavigateUri="{x:Bind WebsiteUri}"
                                            AutomationProperties.Name="{x:Bind LinkAccessibleName}"
                                            Visibility="{x:Bind LinkVisibility, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </Border>
    </StackPanel>
</ContentDialog>
