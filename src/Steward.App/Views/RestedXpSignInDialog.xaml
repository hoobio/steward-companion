<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Steward.App.Views.RestedXpSignInDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CornerRadius="8">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">440</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">440</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <SolidColorBrush x:Key="TextControlBackground" Color="#FF1A1F2B" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF1A1F2B" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF1A1F2B" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FF171C26" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FF343B4C" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF343B4C" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF409FFF" />
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#FF272D3A" />
        <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#FF343B4C" />
        <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#FF409FFF" />
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
        <SolidColorBrush x:Key="TextControlForeground" Color="#FFCBCCC6" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFCBCCC6" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFCBCCC6" />
        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#FF4E5768" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF707A8C" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF707A8C" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF707A8C" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#FF4E5768" />
        <SolidColorBrush x:Key="TextControlHeaderForeground" Color="#FF8A9199" />
        <SolidColorBrush x:Key="TextControlHeaderForegroundDisabled" Color="#FF4E5768" />
        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#FF2F5A85" />
        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#FF2F5A85" />
        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#FF8FB8DD" />
    </ContentDialog.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Sign in to RestedXP"
            Margin="24,22,24,0"
            FontSize="20"
            FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Margin="24,14,24,22" Spacing="14">
            <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.CredentialsVisibility, Mode=OneWay}">
                <TextBlock
                    Text="Your password is used once and never stored."
                    FontSize="12.5"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox
                    Header="Username or email"
                    PlaceholderText="Username or email"
                    FontSize="13.5"
                    MinHeight="32"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    Text="{x:Bind ViewModel.UsernameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <PasswordBox
                    Header="Password"
                    PlaceholderText="Password"
                    FontSize="13.5"
                    MinHeight="32"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    Password="{x:Bind ViewModel.PasswordInput, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.MfaVisibility, Mode=OneWay}">
                <TextBlock
                    Text="{x:Bind ViewModel.UsernameInput, Mode=OneWay}"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <StackPanel Spacing="5" HorizontalAlignment="Center">
                    <TextBlock
                        Text="Authenticator code"
                        HorizontalAlignment="Center"
                        FontSize="12.5"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox
                        x:Name="CodeBox"
                        Width="186"
                        Height="38"
                        MaxLength="7"
                        FontFamily="Cascadia Mono"
                        FontSize="17"
                        CharacterSpacing="120"
                        TextAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Padding="0,9,0,0"
                        Loaded="OnCodeBoxLoaded"
                        InputScope="Number"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        TextChanged="OnCodeChanged" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                Spacing="7"
                Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
                <FontIcon
                    Glyph="&#xEA39;"
                    FontSize="14"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <TextBlock
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    FontSize="12.5"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>
        </StackPanel>

        <Grid
            Grid.Row="2"
            Padding="24,16"
            ColumnSpacing="8"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource RowHairlineBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Height="32"
                HorizontalAlignment="Stretch"
                Style="{StaticResource AccentButtonStyle}"
                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                Command="{x:Bind ViewModel.SignInCommand}"
                Visibility="{x:Bind ViewModel.CredentialsVisibility, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
                    <TextBlock Text="Sign in" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="0"
                Height="32"
                HorizontalAlignment="Stretch"
                Style="{StaticResource AccentButtonStyle}"
                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                Command="{x:Bind ViewModel.VerifyMfaCommand}"
                Visibility="{x:Bind ViewModel.MfaVisibility, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
                    <TextBlock Text="Verify" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="1"
                Height="32"
                Content="Cancel"
                HorizontalAlignment="Stretch"
                Click="OnCancelClick"
                Visibility="{x:Bind ViewModel.CredentialsVisibility, Mode=OneWay}" />

            <Button
                Grid.Column="1"
                Height="32"
                Content="Back"
                HorizontalAlignment="Stretch"
                Click="OnBackClick"
                Visibility="{x:Bind ViewModel.MfaVisibility, Mode=OneWay}" />
        </Grid>
    </Grid>
</ContentDialog>
