<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Steward.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <Color x:Key="SystemAccentColor">#FF409FFF</Color>
                            <Color x:Key="SystemAccentColorLight1">#FF73D0FF</Color>
                            <Color x:Key="SystemAccentColorLight2">#FF73D0FF</Color>
                            <Color x:Key="SystemAccentColorLight3">#FF73D0FF</Color>

                            <Color x:Key="SystemFillColorSuccess">#FFBAE67E</Color>
                            <Color x:Key="SystemFillColorCaution">#FFFFD580</Color>
                            <Color x:Key="SystemFillColorCritical">#FFF28779</Color>
                            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FFBAE67E" />
                            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFFFD580" />
                            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFF28779" />

                            <SolidColorBrush x:Key="RowHairlineBrush" Color="#FF1F2430" />
                            <SolidColorBrush x:Key="SuccessTintBrush" Color="#21BAE67E" />
                            <SolidColorBrush x:Key="CautionTintBrush" Color="#21FFD580" />
                            <SolidColorBrush x:Key="CriticalTintBrush" Color="#21F28779" />
                            <SolidColorBrush x:Key="DiscordBrush" Color="#FF5865F2" />

                            <SolidColorBrush x:Key="ContentSurfaceBrush" Color="{ThemeResource SystemBaseLowColor}" Opacity="0.55" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="ContentSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                            <SolidColorBrush x:Key="RowHairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                            <SolidColorBrush x:Key="SuccessTintBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="CautionTintBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="CriticalTintBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="DiscordBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <x:Double x:Key="SpacingXSmall">4</x:Double>
            <x:Double x:Key="SpacingSmall">8</x:Double>
            <x:Double x:Key="SpacingMedium">12</x:Double>
            <x:Double x:Key="SpacingLarge">16</x:Double>
            <x:Double x:Key="SpacingXLarge">24</x:Double>
            <Thickness x:Key="PageGutter">26</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>
