<ui:FAContentDialog
    x:Class="Steward.Desktop.Views.AddonFoldersDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ui:FAContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
    </ui:FAContentDialog.Resources>

    <StackPanel Spacing="12" MinWidth="360">
        <TextBlock x:Name="Caption" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <StackPanel x:Name="Rows" Spacing="12" />
    </StackPanel>
</ui:FAContentDialog>
