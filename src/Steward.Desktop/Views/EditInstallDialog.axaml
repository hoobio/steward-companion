<ui:FAContentDialog
    x:Class="Steward.Desktop.Views.EditInstallDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="using:Steward.App.ViewModels"
    xmlns:views="using:Steward.Desktop.Views"
    x:DataType="vm:WowInstallViewModel"
    Title="Edit install"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSaveClick">

    <StackPanel Spacing="16">
        <StackPanel Spacing="6">
            <StackPanel>
                <TextBlock Classes="FieldHeader" Text="Name" />
                <TextBox x:Name="NameBox" TextChanged="OnNameTextChanged" />
            </StackPanel>
            <TextBlock
                Classes="Caption"
                Text="Shown in the install picker. Leave empty to use the game version name."
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <StackPanel Spacing="6">
            <StackPanel>
                <TextBlock Classes="FieldHeader ComboBox" Text="Game version" Margin="0,0,0,10" />
                <ComboBox
                    x:Name="GameVersionBox"
                    PlaceholderText="Choose a game version"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnGameVersionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameVersionOption">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Stretch="Uniform"
                                    Source="{Binding Icon, Converter={x:Static views:BindConvert.Image}}"
                                    IsVisible="{Binding IconVisibility}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <TextBlock
                x:Name="GameVersionHint"
                Classes="Caption"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock
                x:Name="GameVersionError"
                Classes="Caption"
                Text="Choose a game version so Steward installs the right addon builds."
                TextWrapping="Wrap"
                IsVisible="False"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Classes="Body" Text="Folder" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Height="32" CornerRadius="4" Padding="10,0,6,0" Background="{DynamicResource ChipBrush}">
                    <TextBlock
                        x:Name="FolderText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource MonoFontFamily}"
                        FontSize="11.5"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
                <Button Grid.Column="1" Content="Change" Click="OnChangeFolderClick" />
            </Grid>
            <TextBlock
                x:Name="FolderError"
                Classes="Caption"
                TextWrapping="Wrap"
                IsVisible="False"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </StackPanel>

        <TextBlock
            x:Name="BusyNote"
            Classes="Caption"
            Text="An update is running on this install. Wait for it to finish before changing the game version or folder."
            TextWrapping="Wrap"
            IsVisible="False"
            Foreground="{DynamicResource SystemFillColorCautionBrush}" />
    </StackPanel>
</ui:FAContentDialog>
