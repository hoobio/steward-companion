<UserControl
    x:Class="Steward.Desktop.Views.SyncPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:views="using:Steward.Desktop.Views"
    xmlns:vm="using:Steward.App.ViewModels"
    x:DataType="vm:SyncViewModel">

    <UserControl.Resources>
        <ControlTheme x:Key="ProfessionsHeaderStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource ExpanderHeaderBackground}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Root" Background="{TemplateBinding Background}" Padding="16,0,0,0" BorderThickness="1" BorderBrush="Transparent">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.083" />
                            </Transitions>
                        </Border.Transitions>
                        <Grid ColumnDefinitions="*,Auto">
                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                VerticalContentAlignment="Stretch" />
                            <Panel Grid.Column="1" Width="32" Height="32" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Name="ChevronDown" Classes="Glyph" Text="{StaticResource Glyph.ChevronDown}" FontSize="12" />
                                <TextBlock Name="ChevronUp" Classes="Glyph" Text="{StaticResource Glyph.ChevronUp}" FontSize="12" IsVisible="False" />
                            </Panel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Root">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Style>
            <Style Selector="^:pressed /template/ Border#Root">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
            </Style>
            <Style Selector="^:checked /template/ TextBlock#ChevronDown">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^:checked /template/ TextBlock#ChevronUp">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </ControlTheme>

        <DataTemplate x:Key="PullDatasetTemplate" x:DataType="vm:SyncDatasetViewModel">
            <Border
                BorderThickness="{Binding ShowsHairline, Converter={x:Static views:BindConvert.TopHairline}}"
                BorderBrush="{DynamicResource RowHairlineBrush}"
                Padding="{StaticResource CardRowPadding}"
                MinHeight="{StaticResource CardRowMinHeight}">
                <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="12">
                    <Border
                        Width="30"
                        Height="30"
                        VerticalAlignment="Center"
                        CornerRadius="6"
                        ClipToBounds="True"
                        Background="{DynamicResource ChipBrush}">
                        <Image Source="{Binding IconSource, Converter={x:Static views:BindConvert.Image}}" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                Classes="Glyph"
                                Text="{StaticResource Glyph.CheckMark}"
                                FontSize="12"
                                Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                IsVisible="{Binding SyncedGlyphVisibility}" />
                            <TextBlock
                                Text="{Binding StatusText}"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Text="{Binding RecordsText}"
                        FontSize="12.5"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProfessionsCharacterTemplate" x:DataType="vm:ProfessionsCharacterViewModel">
            <Border
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource RowHairlineBrush}"
                Padding="{StaticResource CardRowPadding}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock
                            Text="{Binding LevelClassText}"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="{Binding SkillsSummary}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            IsVisible="{Binding SkillsVisibility}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="200">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Right"
                            IsVisible="{Binding SyncedVisibility}">
                            <TextBlock
                                Classes="Glyph"
                                Text="{StaticResource Glyph.CheckMark}"
                                FontSize="12"
                                Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock
                                Text="Synced"
                                FontSize="12"
                                Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        </StackPanel>
                        <TextBlock
                            Text="Changed, sending shortly"
                            FontSize="12"
                            TextAlignment="Right"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            IsVisible="{Binding PendingVisibility}" />
                        <TextBlock
                            Text="{Binding ReasonText}"
                            FontSize="12"
                            TextAlignment="Right"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            IsVisible="{Binding RejectedVisibility}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InstallTemplate" x:DataType="vm:SyncInstallViewModel">
            <StackPanel>
                <StackPanel Margin="16,8" Spacing="4" IsVisible="{Binding OldFormatVisibility}">
                    <TextBlock Classes="Body" Text="Update the Steward addon" FontWeight="SemiBold" />
                    <TextBlock
                        Classes="Body"
                        Text="This install's Steward.lua is from an older addon version that does not export characters, professions or the recipe catalogue."
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock
                    Margin="16,10"
                    Text="{Binding ReadError}"
                    TextWrapping="Wrap"
                    FontSize="12"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    IsVisible="{Binding ReadErrorVisibility}" />
                <ItemsControl
                    ItemsSource="{Binding PullDatasets}"
                    ItemTemplate="{StaticResource PullDatasetTemplate}"
                    IsVisible="{Binding DatasetsVisibility}" />
                <Border
                    BorderBrush="{DynamicResource RowHairlineBrush}"
                    BorderThickness="{Binding ShowsProfessionsHairline, Converter={x:Static views:BindConvert.TopHairline}}"
                    IsVisible="{Binding DatasetsVisibility}">
                    <StackPanel>
                        <ToggleButton
                            Theme="{StaticResource ProfessionsHeaderStyle}"
                            AutomationProperties.Name="{Binding ProfessionsDataset.Name, FallbackValue=''}"
                            IsChecked="{Binding IsProfessionsExpanded, Mode=TwoWay}">
                            <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="12" Margin="0,0,20,0" MinHeight="{StaticResource CardRowMinHeight}">
                                <Border
                                    Width="30"
                                    Height="30"
                                    VerticalAlignment="Center"
                                    CornerRadius="6"
                                    ClipToBounds="True"
                                    Background="{DynamicResource ChipBrush}">
                                    <Image Source="{Binding ProfessionsDataset.IconSource, Converter={x:Static views:BindConvert.Image}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProfessionsDataset.Name, FallbackValue=''}" FontSize="13.5" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock
                                            Classes="Glyph"
                                            Text="{StaticResource Glyph.CheckMark}"
                                            FontSize="12"
                                            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                            IsVisible="{Binding ProfessionsDataset.SyncedGlyphVisibility, FallbackValue=False}" />
                                        <TextBlock
                                            Text="{Binding ProfessionsDataset.StatusText, FallbackValue=''}"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock
                                        Text="{Binding ProfessionsDataset.CharacterSync.Error, FallbackValue=''}"
                                        TextWrapping="Wrap"
                                        FontSize="12"
                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                        IsVisible="{Binding ProfessionsDataset.CharacterSync.ErrorVisibility, FallbackValue=False}" />
                                    <TextBlock
                                        Text="{Binding ProfessionsDataset.Note, FallbackValue=''}"
                                        TextWrapping="Wrap"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        IsVisible="{Binding ProfessionsDataset.NoteVisibility, FallbackValue=False}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Text="{Binding ProfessionsDataset.RecordsText, FallbackValue=''}"
                                    FontSize="12.5"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </ToggleButton>
                        <StackPanel
                            Background="{DynamicResource ExpanderContentBackground}"
                            IsVisible="{Binding IsProfessionsExpanded}">
                            <ItemsControl
                                ItemsSource="{Binding ProfessionsCharacters}"
                                ItemTemplate="{StaticResource ProfessionsCharacterTemplate}" />
                            <TextBlock
                                Text="No characters of yours on this install yet."
                                Margin="16,8"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                IsVisible="{Binding NoOwnCharactersVisibility}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Grid.Row" Value="1" />
        </Style>
        <Style Selector="Border.card.pinned">
            <Setter Property="Grid.Row" Value="2" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Name="Scroller">
        <Border Padding="{StaticResource PageGutter}" MinHeight="{Binding #Scroller.Bounds.Height}">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Sync"
                                FontFamily="{StaticResource DisplayFontFamily}"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Margin="{StaticResource PageTitleMargin}" />
                            <TextBlock Classes="Body" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{Binding SubtitleGuild}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Run Text="{Binding SubtitleSynced}" />
                            </TextBlock>
                            <TextBlock
                                Classes="Body"
                                Text="WoW is running, /reload to load new data"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                IsVisible="{Binding SubtitleRunningVisibility}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                            <Button
                                Width="32"
                                Height="32"
                                Padding="0"
                                Theme="{StaticResource DefaultButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                AutomationProperties.Name="Refresh"
                                ToolTip.Tip="Read the local files again">
                                <TextBlock
                                    Classes="Glyph"
                                    Text="{StaticResource Glyph.Refresh}"
                                    FontSize="14"
                                    views:Spinner.IsSpinning="{Binding RefreshCommand.IsRunning}" />
                            </Button>
                            <Button
                                Height="32"
                                Content="Sync now"
                                Theme="{StaticResource AccentButtonStyle}"
                                Command="{Binding SyncNowCommand}"
                                IsVisible="{Binding SyncNowVisibility}"
                                ToolTip.Tip="Push characters to the guild now" />
                        </StackPanel>
                    </Grid>

                    <views:BannerList Banners="{Binding Main.Banners}" />

                    <ui:FAInfoBar
                        Severity="Error"
                        IsClosable="False"
                        IsOpen="{Binding UnreachableIsOpen}"
                        Message="Could not reach api.hoobi.io. Check your connection." />
                </StackPanel>

                <StackPanel Grid.RowSpan="3" Spacing="10" VerticalAlignment="Center">
                    <StackPanel
                        HorizontalAlignment="Center"
                        MaxWidth="460"
                        Spacing="12"
                        Margin="0,24"
                        IsVisible="{Binding NoInstallVisibility}">
                        <TextBlock
                            Classes="Glyph"
                            Text="{StaticResource Glyph.Oem}"
                            FontSize="44"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="No World of Warcraft install found"
                            FontFamily="{StaticResource DisplayFontFamily}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            TextAlignment="Center" />
                        <TextBlock
                            Classes="Body"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Steward could not find a World of Warcraft: Forever install on this machine." />
                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Center"
                        MaxWidth="460"
                        Spacing="12"
                        Margin="0,24"
                        IsVisible="{Binding AddonMissingVisibility}">
                        <TextBlock
                            Classes="Glyph"
                            Text="{StaticResource Glyph.Game}"
                            FontSize="44"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="The Steward addon is not installed"
                            FontFamily="{StaticResource DisplayFontFamily}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            TextAlignment="Center" />
                        <TextBlock
                            Classes="Body"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Sync reads roster, loot and attendance from the Steward addon's saved variables. The addon has no releases yet." />
                        <HyperlinkButton
                            Content="Open guild panel"
                            HorizontalAlignment="Center"
                            NavigateUri="https://guild.hoobi.io" />
                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Center"
                        MaxWidth="460"
                        Spacing="12"
                        Margin="0,24"
                        IsVisible="{Binding NeverExportedVisibility}">
                        <TextBlock
                            Classes="Glyph"
                            Text="{StaticResource Glyph.Page}"
                            FontSize="44"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="Steward has not exported anything yet"
                            FontFamily="{StaticResource DisplayFontFamily}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            TextAlignment="Center" />
                        <TextBlock
                            Classes="Body"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Log in to a character. The addon writes its data when you log out, exit, or type /reload." />
                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Center"
                        MaxWidth="460"
                        Spacing="12"
                        Margin="0,24"
                        IsVisible="{Binding NotReleasedVisibility}">
                        <TextBlock
                            Classes="Glyph"
                            Text="{StaticResource Glyph.Game}"
                            FontSize="44"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="World of Warcraft: Forever is not out yet"
                            FontFamily="{StaticResource DisplayFontFamily}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            TextAlignment="Center" />
                        <TextBlock
                            Classes="Body"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{x:Static vm:SyncViewModel.NotReleasedText}" />
                    </StackPanel>
                </StackPanel>

                <Border
                    Classes="card"
                    VerticalAlignment="Top"
                    CornerRadius="8"
                    ClipToBounds="True"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    IsVisible="{Binding CardVisibility}"
                    Classes.pinned="{Binding !CardsVisibility}">
                    <StackPanel>
                        <ItemsControl
                            ItemsSource="{Binding Installs}"
                            ItemTemplate="{StaticResource InstallTemplate}"
                            IsVisible="{Binding CardsVisibility}" />

                        <Border
                            BorderThickness="{Binding ShowsJourneyHairline, Converter={x:Static views:BindConvert.TopHairline}}"
                            BorderBrush="{DynamicResource RowHairlineBrush}"
                            Padding="{StaticResource CardRowPadding}"
                            MinHeight="{StaticResource CardRowMinHeight}"
                            IsVisible="{Binding JourneyVisibility}">
                            <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="12">
                                <Border
                                    Width="30"
                                    Height="30"
                                    VerticalAlignment="Center"
                                    CornerRadius="6"
                                    ClipToBounds="True"
                                    Background="{DynamicResource ChipBrush}">
                                    <Image Source="avares://Steward.Desktop/Assets/Journeys.png" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Character journeys" FontSize="13.5" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Main.JourneyOkVisibility}">
                                        <TextBlock
                                            Classes="Glyph"
                                            Text="{StaticResource Glyph.CheckMark}"
                                            FontSize="12"
                                            Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <TextBlock
                                            Text="Uploaded after you log out"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock
                                        Text="{Binding Main.JourneyError}"
                                        TextWrapping="Wrap"
                                        FontSize="12"
                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                        IsVisible="{Binding Main.JourneyErrorVisibility}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Text="{Binding Main.JourneyCount}"
                                    FontSize="12.5"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Border>

                        <Border
                            BorderThickness="{Binding ShowsGeneratedFileHairline, Converter={x:Static views:BindConvert.TopHairline}}"
                            BorderBrush="{DynamicResource RowHairlineBrush}"
                            Padding="{StaticResource CardRowPadding}"
                            MinHeight="{StaticResource CardRowMinHeight}">
                            <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="12">
                                <TextBlock
                                    Classes="Glyph"
                                    Text="{StaticResource Glyph.Document}"
                                    FontSize="16"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Guild data in game" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock
                                        FontSize="12"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        ToolTip.Tip="{Binding GeneratedFilePath}">
                                        <Run Text="StewardSync.lua" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" /><Run Text="{Binding GeneratedFileStatus}" />
                                    </TextBlock>
                                    <TextBlock
                                        Text="{Binding GeneratedFileError}"
                                        TextWrapping="Wrap"
                                        FontSize="12"
                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                        IsVisible="{Binding GeneratedFileErrorVisibility}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <views:ProgressRing
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        IsActive="{Binding WriteAgainCommand.IsRunning}"
                                        IsVisible="{Binding WriteAgainCommand.IsRunning}" />
                                    <Button
                                        Height="32"
                                        Content="Write again"
                                        Theme="{StaticResource DefaultButtonStyle}"
                                        Command="{Binding WriteAgainCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
