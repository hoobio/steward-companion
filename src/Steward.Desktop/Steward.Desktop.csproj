<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows10.0.26100.0</TargetFrameworks>
    <RootNamespace>Steward.Desktop</RootNamespace>
    <SelfContained>true</SelfContained>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- AVLN3001: views take their view models through the constructor and are never loaded by URI at runtime -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Steward</AssemblyTitle>
    <ApplicationIcon>Assets\Steward.ico</ApplicationIcon>
    <GitHubRelease Condition="'$(GitHubRelease)' == ''">false</GitHubRelease>
    <StorePreRelease Condition="'$(StorePreRelease)' == ''">false</StorePreRelease>
    <PortableZip Condition="'$(PortableZip)' == ''">false</PortableZip>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="appsettings.json" LogicalName="Steward.Desktop.appsettings.json" />
    <AvaloniaResource Include="Assets\Steward.ico" />
    <AvaloniaResource Include="Assets\Steward-256.png" />
    <AvaloniaResource Include="Assets\Professions.png" />
    <AvaloniaResource Include="Assets\GuildProfessions.png" />
    <AvaloniaResource Include="Assets\GuildRoster.png" />
    <AvaloniaResource Include="Assets\Journeys.png" />
    <AvaloniaResource Include="Assets\Products\*.png" />
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <Content Include="Assets\Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="GitHubRelease" Value="$(GitHubRelease)" />
    <AssemblyMetadata Include="StorePreRelease" Value="$(StorePreRelease)" />
    <AssemblyMetadata Include="PortableZip" Value="$(PortableZip)" />
  </ItemGroup>

  <ItemGroup Condition="'$(StoreDisplayVersion)' != ''">
    <AssemblyMetadata Include="StoreDisplayVersion" Value="$(StoreDisplayVersion)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="8388608" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Steward.Core\Steward.Core.csproj" />
    <ProjectReference Include="..\Steward.Presentation\Steward.Presentation.csproj" />
  </ItemGroup>

  <!-- Installed WinUI builds start Steward.App.exe from the Run value, pins, the MSI's taskkill and the Store manifest, so a Windows publish keeps that name. -->
  <Target Name="NameWindowsExeStewardApp" AfterTargets="Publish" Condition="'$(TargetPlatformIdentifier)' == 'windows' and $(RuntimeIdentifier.StartsWith('win'))">
    <Move SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)Steward.App.exe" />
  </Target>

</Project>
