<?xml version="1.0" encoding="UTF-8"?>
<!--
  Steward MSI installer (WiX 5). Per-user, unpackaged, x64 only.

  Preprocessor variables supplied by the build pipeline:
    Version    - four-part version (X.Y.Z.W), sourced from version.txt.
    Platform   - "x64". Kept as a variable so the wxs matches the house pattern even
                 though only one architecture ships today.
    PayloadDir - root of the published self-contained build to wrap.

  WixUI_InstallDir with the licence dialog skipped: the repo has no licence file, so the
  flow is Welcome, InstallDir, Ready, Progress, Exit, with the Steward bitmaps beside
  this file on the chrome. Extensions are pinned to the WiX tool version in build.yaml.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?define UpgradeCodeGuid = "CCD0BF88-7A8E-4F74-9DB7-9B9272B3D503" ?>
  <?define ShortcutGuid = "DA062698-AF5C-4CA3-B0BB-FF90D287B0C1" ?>
  <?define AppExeComponentGuid = "8DE16ADB-505E-45E7-BCE1-E2A8654B0CBB" ?>

  <Package
      Name="Steward"
      Manufacturer="hoobio"
      Version="$(var.Version)"
      UpgradeCode="$(var.UpgradeCodeGuid)"
      Scope="perUser"
      Compressed="yes"
      InstallerVersion="500">

    <SummaryInformation Description="Steward installer" />

    <!-- A pre-release MSI carries the same numeric version as the release that follows it, and switching back to the release channel installs an older number. -->
    <MajorUpgrade
        AllowDowngrades="yes"
        Schedule="afterInstallInitialize" />

    <Media Id="1" Cabinet="Steward.cab" EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="StewardIcon" SourceFile="$(var.PayloadDir)\Assets\Steward.ico" />

    <Property Id="ARPPRODUCTICON" Value="StewardIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/hoobio/steward-companion" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/hoobio/steward-companion" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Steward" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="$(var.ShortcutGuid)">
        <Shortcut Id="StewardShortcut"
                  Name="Steward"
                  Description="Keeps Hoobi's WoW addons current"
                  Target="[INSTALLFOLDER]Steward.App.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="StewardIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\hoobio\Steward"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Steward" Level="1" AllowAdvertise="no">
      <ComponentGroupRef Id="StewardPayload" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- A tray-parked Steward cancels WM_CLOSE and hides instead, so the terminate fallback is what actually frees the files. -->
    <util:CloseApplication Id="CloseSteward"
                           Target="Steward.App.exe"
                           CloseMessage="yes"
                           RebootPrompt="no"
                           Timeout="5"
                           TerminateProcess="0" />

    <CustomAction Id="LaunchSteward"
                  FileRef="StewardAppExe"
                  ExeCommand=""
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchSteward" After="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
                 Value="Start Steward with Windows"
                 After="FindRelatedProducts"
                 Sequence="ui"
                 Condition="NOT WIX_UPGRADE_DETECTED" />
    <SetProperty Id="RegisterStartup"
                 Value='"[SystemFolder]reg.exe" add HKCU\Software\Microsoft\Windows\CurrentVersion\Run /v Steward /t REG_SZ /d "\"[INSTALLFOLDER]Steward.App.exe\" --tray" /f'
                 Before="ExecuteAction"
                 Sequence="ui" />
    <CustomAction Id="RegisterStartup"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="immediate"
                  Return="ignore" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)WixUIBannerBmp.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)WixUIDialogBmp.bmp" />

    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="99" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="RegisterStartup" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed AND NOT WIX_UPGRADE_DETECTED" Order="98" />
    </UI>

  </Package>

  <Fragment>
    <ComponentGroup Id="StewardPayload" Directory="INSTALLFOLDER">
      <Component Id="StewardAppExeComponent" Guid="$(var.AppExeComponentGuid)">
        <File Id="StewardAppExe"
              Source="$(var.PayloadDir)\Steward.App.exe"
              KeyPath="yes" />
      </Component>
      <Files Include="$(var.PayloadDir)\**">
        <Exclude Files="$(var.PayloadDir)\Steward.App.exe" />
      </Files>
    </ComponentGroup>
  </Fragment>

</Wix>
